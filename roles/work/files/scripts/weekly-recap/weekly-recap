#!/usr/bin/env python3
"""Summarise recent Jira, GitHub and GitLab activity as markdown.

Output is grouped by project or repo, ready to paste into a weekly meeting doc.
Each platform degrades on its own: an unauthenticated or failing CLI records one
note line and never blocks the other two, so a partial recap still prints.
"""

import argparse
import concurrent.futures
import json
import re
import subprocess
import sys
from dataclasses import dataclass
from datetime import date, timedelta
from pathlib import Path

# The shared line vocabulary, reached the same way the claude-kit shim reaches its
# package: by putting this file's own directory on sys.path. Every python script in
# this directory does it, which is what keeps one palette across all of them.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from dotkit import ui  # noqa: E402

EXIT_OK = 0
EXIT_USAGE = 1

DEFAULT_DAYS = 7
QUERY_LIMIT = 100
QUERY_TIMEOUT = 60

PLATFORM_ORDER = ("Jira", "GitHub", "GitLab")

# One PR or MR surfaces in several queries at once, so the strongest label wins:
# "merged" survives a collision with the "opened" that created it.
LABEL_RANK = {"merged": 3, "opened": 2, "reviewed": 1}

# Jira summaries and MR titles arrive with whatever punctuation their author used,
# and the recap must not carry em or en dashes into the meeting doc. Built from
# codepoints so the em-dash-gate hook never trips on this file itself.
DASHES = str.maketrans({chr(0x2014): "-", chr(0x2013): "-"})

# --fields takes a fixed whitelist (issuetype, key, assignee, priority, status,
# summary, reporter, labels, description, creator) and rejects any other name
# outright, so asking for `project` or `updated` fails the whole query instead of
# just omitting them. The flag is left off so --json returns whatever acli gives
# natively. Neither field the recap wants is reachable this way, so the group
# comes from the issue key prefix and the ordering from the ORDER BY below, which
# a stable sort preserves once every Jira item ties on an empty timestamp.
JIRA_JQL = (
    "(assignee = currentUser() OR reporter = currentUser()) "
    'AND updated >= "{since}" ORDER BY updated DESC'
)

# `gh search prs` has no mergedAt field; merge time is only a search qualifier.
# state carries the outcome and updatedAt is what the report sorts on.
GH_FIELDS = "repository,number,title,state,url,updatedAt,author"

# glab reports every authenticated host on stderr as a human-readable block.
# Anchoring on the indented "Logged in to <host> as <user>" line yields host and
# username together, and skips the flush-left "ERROR:" lines that a scan for
# unindented hostnames would otherwise collect as an account.
GLAB_ACCOUNT = re.compile(r"Logged in to (\S+) as (\S+)")


@dataclass(frozen=True)
class Item:
    platform: str
    group: str
    ref: str
    label: str
    title: str
    updated: str
    author: str = ""

    def render(self):
        suffix = f", author: {self.author}" if self.author else ""
        return f"- {self.ref} ({self.label}{suffix}) {self.title}"


def fail(code, message):
    ui.err(message)
    return code


def run(argv):
    """Capture stdout and stderr separately.

    glab writes an unrelated config warning to stderr on a sandboxed run, which
    corrupts the JSON body if the two streams are merged.
    """
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=QUERY_TIMEOUT)
    except FileNotFoundError:
        return None, f"{argv[0]} is not installed"
    except subprocess.TimeoutExpired:
        return None, f"{argv[0]} timed out after {QUERY_TIMEOUT}s"
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip().splitlines()
        return None, detail[0].strip() if detail else f"{argv[0]} exited {proc.returncode}"
    return proc.stdout, None


def run_json(argv):
    out, err = run(argv)
    if err is not None:
        return None, err
    try:
        return json.loads(out or "null"), None
    except json.JSONDecodeError:
        return None, f"{argv[0]} returned output that is not JSON"


def clean(title):
    return " ".join(title.split()).translate(DASHES)


def keep_strongest(best, key, item):
    current = best.get(key)
    if current is None or LABEL_RANK[item.label] > LABEL_RANK[current.label]:
        best[key] = item


def _records(payload, *keys):
    """acli's --json envelope is undocumented, so accept a bare array or any of
    the plausible wrapper keys instead of betting on one."""
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        for key in keys:
            value = payload.get(key)
            if isinstance(value, list):
                return value
    return []


def collect_jira(since):
    _, err = run(["acli", "jira", "auth", "status"])
    if err is not None:
        return [], ["Jira: not authenticated, run `acli jira auth login --web`"]

    payload, err = run_json(
        [
            "acli", "jira", "workitem", "search",
            "--jql", JIRA_JQL.format(since=since),
            "--json",
            "--limit", str(QUERY_LIMIT),
        ]
    )
    if err is not None:
        return [], [f"Jira: query failed ({err})"]

    items = []
    for record in _records(payload, "issues", "workItems", "results", "values"):
        key = record.get("key") or ""
        if not key:
            continue
        # Some acli versions flatten the fields object onto the record.
        fields = record.get("fields") or record
        project = (fields.get("project") or {}).get("key") or key.split("-")[0]
        items.append(
            Item(
                platform="Jira",
                group=project,
                ref=key,
                label=(fields.get("status") or {}).get("name") or "unknown",
                title=clean(fields.get("summary") or ""),
                updated=fields.get("updated") or "",
            )
        )
    return items, []


def _gh_label(bucket, pull_request, me):
    state_label = "merged" if pull_request.get("state") == "merged" else "opened"
    author = (pull_request.get("author") or {}).get("login") or ""
    if bucket == "reviewed":
        # A PR I both authored and reviewed is not a review contribution.
        return "reviewed" if author and author != me else state_label
    if bucket == "opened":
        return state_label
    return bucket


def collect_github(since):
    identity, err = run_json(["gh", "api", "user"])
    if err is not None:
        return [], ["GitHub: not authenticated, run `gh auth login`"]
    me = (identity or {}).get("login") or ""

    tail = ["--json", GH_FIELDS, "--limit", str(QUERY_LIMIT)]
    searches = (
        (["gh", "search", "prs", "--author=@me", f"--created=>={since}"], "opened"),
        (
            ["gh", "search", "prs", "--author=@me", "--merged", f"--merged-at=>={since}"],
            "merged",
        ),
        (["gh", "search", "prs", "--reviewed-by=@me", f"--updated=>={since}"], "reviewed"),
    )

    def probe(search):
        argv, bucket = search
        payload, error = run_json(argv + tail)
        return bucket, payload, error

    notes = []
    best = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(searches)) as pool:
        for bucket, payload, error in pool.map(probe, searches):
            if error is not None:
                notes.append(f"GitHub: the {bucket} query failed ({error})")
                continue
            for pull_request in payload or []:
                url = pull_request.get("url")
                if not url:
                    continue
                label = _gh_label(bucket, pull_request, me)
                author = (pull_request.get("author") or {}).get("login") or ""
                keep_strongest(
                    best,
                    url,
                    Item(
                        platform="GitHub",
                        group=(pull_request.get("repository") or {}).get("nameWithOwner")
                        or "unknown",
                        ref=f"#{pull_request.get('number')}",
                        label=label,
                        title=clean(pull_request.get("title") or ""),
                        updated=pull_request.get("updatedAt") or "",
                        author=author if label == "reviewed" else "",
                    ),
                )
    return list(best.values()), notes


def glab_accounts():
    """Every authenticated (host, username) pair, in the order glab reports them.

    Personal and work accounts share api_host gitlab.com but use different
    tokens, so a default-host query only ever sees one of them.
    """
    try:
        proc = subprocess.run(
            ["glab", "auth", "status"], capture_output=True, text=True, timeout=QUERY_TIMEOUT
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    seen = []
    for account in GLAB_ACCOUNT.findall(f"{proc.stderr}\n{proc.stdout}"):
        if account not in seen:
            seen.append(account)
    return seen


def _gl_item(merge_request, bucket, me, since):
    author = (merge_request.get("author") or {}).get("username") or ""
    merged_at = merge_request.get("merged_at") or ""
    if merge_request.get("state") == "merged" and merged_at[:10] >= since:
        label = "merged"
    elif bucket == "reviewed" and author and author != me:
        label = "reviewed"
    else:
        label = "opened"
    group, _, _ = ((merge_request.get("references") or {}).get("full") or "").partition("!")
    return Item(
        platform="GitLab",
        group=group or "unknown",
        ref=f"!{merge_request.get('iid')}",
        label=label,
        title=clean(merge_request.get("title") or ""),
        updated=merge_request.get("updated_at") or "",
        author=author if label == "reviewed" else "",
    )


def collect_gitlab(since):
    accounts = glab_accounts()
    if not accounts:
        return [], ["GitLab: not authenticated, run `glab auth login`"]

    window = f"{since}T00:00:00Z"

    def probe(account):
        host, me = account
        queries = (
            (f"merge_requests?scope=created_by_me&updated_after={window}", "opened"),
            (f"merge_requests?reviewer_username={me}&updated_after={window}", "reviewed"),
        )
        found, notes = [], []
        for path, bucket in queries:
            payload, error = run_json(
                ["glab", "api", "--hostname", host, f"{path}&per_page={QUERY_LIMIT}"]
            )
            if error is not None:
                notes.append(f"GitLab ({host}): the {bucket} query failed ({error})")
                continue
            for merge_request in payload or []:
                found.append((merge_request, bucket, me))
        return found, notes

    notes = []
    best = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(accounts)) as pool:
        for found, host_notes in pool.map(probe, accounts):
            notes.extend(host_notes)
            for merge_request, bucket, me in found:
                url = merge_request.get("web_url")
                if not url:
                    continue
                # Keyed on web_url across every host, so one MR visible under
                # both accounts collapses to a single line.
                keep_strongest(best, url, _gl_item(merge_request, bucket, me, since))
    return list(best.values()), notes


COLLECTORS = {
    "Jira": collect_jira,
    "GitHub": collect_github,
    "GitLab": collect_gitlab,
}


def render(since, today, sections):
    """Markdown only, no preamble and no trailing commentary.

    Notes sit under the title rather than inside their platform's section: a
    platform that failed has no groups, and an orphan header reads as real data.
    """
    items = [item for _, platform_items, _ in sections for item in platform_items]
    notes = [note for _, _, platform_notes in sections for note in platform_notes]

    lines = [f"# Weekly recap, {since} to {today}", ""]
    if notes:
        lines.extend([*notes, ""])

    if not items:
        lines.append(f"No activity recorded between {since} and {today}.")
        return "\n".join(lines).rstrip() + "\n"

    groups = {}
    for item in items:
        groups.setdefault((item.group, item.platform), []).append(item)

    for key in sorted(groups, key=lambda k: (k[0].lower(), PLATFORM_ORDER.index(k[1]))):
        group, platform = key
        lines.append(f"## {group} ({platform})")
        lines.extend(
            item.render()
            for item in sorted(groups[key], key=lambda i: i.updated, reverse=True)
        )
        lines.append("")

    return "\n".join(lines).rstrip() + "\n"


class Parser(argparse.ArgumentParser):
    """argparse exits 2 on a usage error; this script only defines 0 and 1."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, ui.render("err", message, stream=sys.stderr) + "\n")


def main(argv=None):
    parser = Parser(prog="weekly-recap", description=__doc__.splitlines()[0])
    parser.add_argument(
        "--days",
        type=int,
        default=DEFAULT_DAYS,
        help=f"window length in days (default {DEFAULT_DAYS})",
    )
    parser.add_argument(
        "--since", metavar="YYYY-MM-DD", help="explicit window start, overrides --days"
    )
    args = parser.parse_args(argv)

    if args.days < 1:
        return fail(EXIT_USAGE, "--days must be at least 1.")
    today = date.today()
    if args.since:
        try:
            start = date.fromisoformat(args.since)
        except ValueError:
            return fail(EXIT_USAGE, f"--since must be an ISO date, got {args.since!r}.")
    else:
        start = today - timedelta(days=args.days)

    since = start.isoformat()
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(COLLECTORS)) as pool:
        futures = {
            platform: pool.submit(collect, since) for platform, collect in COLLECTORS.items()
        }
    sections = [(platform, *futures[platform].result()) for platform in PLATFORM_ORDER]

    print(render(since, today.isoformat(), sections), end="")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
