#!/usr/bin/env python3
"""Per-project development domains on http://<name>.localhost.

Every project on `localhost` shares one cookie jar, because cookies isolate by hostname
and ignore the port entirely, so signing into one admin panel clobbers another's session
even when the two run on different ports. A distinct hostname per project is the whole fix.

Two separate things have to be true for a project to answer on its own hostname, and this
tool owns both:

  /etc/hosts  Belt and braces, not the load-bearing half this was written as. macOS 26
              resolves every *.localhost name to loopback itself, per RFC 6761, so
              getaddrinfo and curl answer for a name in no file at all. The block stays
              because it costs one idempotent line and survives a DNS profile, an MDM
              payload or a VPN's split-DNS shadowing that handling, and because a fresh
              machine on an older macOS has nothing else. dnsmasq behind /etc/resolver is
              still not the alternative it is elsewhere: mDNSResponder intercepts every TLD
              absent from the IANA root zone and answers it as multicast DNS, never
              consulting the nameserver the resolver file names, so `dig @127.0.0.1`
              succeeds while the system resolver returns nothing. That is why the suffix
              cannot be .test or .internal.
  sites/      One Caddy site file per domain, imported by the Caddyfile, so the portless
              http://my-custom-project.localhost answers on :80 and routes by Host header to
              the port the dev server actually binds.

Use the portless URL. A port reaches the dev server whatever hostname is in front of it, so
http://anything.localhost:4321 serves whichever project holds 4321, while cookies key on
hostname and ignore the port. On :80 the Host header is the only discriminator, which is what
keeps one project's session out of another's jar. No --host is needed for that: Caddy dials
127.0.0.1 with an [::1] fallback, so a default loopback bind is already reachable.

The two are kept consistent by deriving one from the other. The site files are the record,
committed to this repo, and the /etc/hosts block is rewritten from them on every change,
which is what makes `lokl sync` enough to bring a fresh machine up from a clone.
"""

import argparse
import collections
import hashlib
import os
import re
import shutil
import socket
import subprocess
import sys
from pathlib import Path

# The shared line vocabulary, reached the same way the claude-kit shim reaches its package:
# by putting this file's own directory on sys.path.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from dotkit import ui  # noqa: E402

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_NOT_FOUND = 2
EXIT_INVALID = 3
EXIT_PRIVILEGE = 4
EXIT_UNRESOLVED = 5

# The suffix cannot be prettier than this. Vite's `allowedHosts` permits `localhost`, the
# dot-prefixed `.localhost` and every IP address by default, and rejects other names over
# plain HTTP, so any other choice would need `allowedHosts` written into a committed
# vite.config.ts in each project. The dot-prefixed form covers subdomains at any depth, which
# is what lets a nested name work with no project config at all.
SUFFIX = "localhost"

# Parent plus one level of children, which is what a shared cookie jar needs. `.localhost` is
# absent from the Public Suffix List, so its eTLD is `localhost` and every `<name>.localhost`
# is a registrable domain of its own: `pot-app.localhost` and `pot-api.localhost` are mutually
# cross-site, which is what drops a SameSite=Lax cookie between them. Nesting them as
# `app.pot.localhost` and `api.pot.localhost` puts both under the registrable domain
# `pot.localhost`, so they are same-site and a `Domain=pot.localhost` cookie reaches both.
#
# A third level buys nothing the second does not already give and costs another hosts line and
# another site file per name. And this fixes cookies, not CORS: a different host is still a
# different origin, so the call still needs `Access-Control-Allow-Origin` on the API.
MAX_LABELS = 2

# How far `lokl list` insets a subdomain beyond its parent's row. `ui.item` already insets
# every row, and that base is read from the kind table rather than repeated here, so a change
# there cannot silently push the port column out of line.
NEST_INDENT = 2
ITEM_INDENT = ui.KINDS["item"][-1]

# One address in the hosts entry, where the file would happily carry two, but this no longer
# decides anything: macOS answers every *.localhost name with both families whatever the entry
# says, so "which family did it bind" is a question only the upstream pair below can settle.
# The single line stays because a second one would add nothing the resolver is not already doing.
LOOPBACK = "127.0.0.1"

# Both families, because a name resolving to the pair is the normal answer here rather than a
# fault to report. Only an address outside this set means something else claimed the name.
LOOPBACK_ADDRESSES = frozenset({LOOPBACK, "::1"})

BEGIN = "# lokl: development domains. Rewritten by `lokl`, hand edits below are lost."
END = "# lokl: end"

# Caddy binds the first and serves its admin API on the second, so a site pointing at
# either is a proxy loop rather than a project.
RESERVED = {
    80: "Caddy itself binds :80, so a site pointing there would proxy to itself",
    2019: "Caddy's admin API listens on :2019",
}

# The window a derived port falls in. Both edges are chosen rather than round:
#
#   below 49152  where macOS starts its ephemeral range, so a port here is never one the
#                kernel might already have handed to an outbound connection.
#   above 19999  clear of every port a dev server picks by default (3000, 3001, 4321,
#                5173, 8000, 8080) and of the databases beside them (5432, 6379, 27017),
#                so a derived port cannot collide with something started by hand.
PORT_FLOOR = 20000
PORT_CEILING = 39999
PORT_SPAN = PORT_CEILING - PORT_FLOOR + 1

LABEL = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
SITE_HOST = re.compile(r"^http://(\S+)\s*\{", re.M)
SITE_UPSTREAMS = re.compile(r"^\s*reverse_proxy\s+([^\n{]*)", re.M)
UPSTREAM_PORT = re.compile(r":(\d+)$")

Paths = collections.namedtuple("Paths", "caddyfile sites hosts overridden")

# `ports` carries every port on the reverse_proxy line where `port` carries the first alone.
# `render_site` writes one number twice, so two different numbers are a hand edit that
# `lb_policy first` then resolves silently, which is the one state reading only the first
# upstream could never see.
Site = collections.namedtuple("Site", "port path ports")


def fail(code, message):
    ui.err(message)
    return code


def resolve_paths():
    """Where the Caddyfile, the site files and the hosts file live.

    `LOKL_CADDYFILE` and `LOKL_HOSTS` are the only environmental seams, which is what lets
    the whole tool be driven against a tmp_path. The literal prefix is the same constant
    the playbook writes into `CADDYFILE_PATH`, and this repo is Apple Silicon only.

    Either override sets `overridden`, and the two steps that reach past the files being
    edited (reloading the live proxy, and asking the system resolver whether the entry
    took) stand down when it is set. Both would be answering about the machine while the
    tool is working on something else.
    """
    override = os.environ.get("LOKL_CADDYFILE")
    prefix = os.environ.get("HOMEBREW_PREFIX", "/opt/homebrew")
    caddyfile = Path(override) if override else Path(prefix) / "etc" / "Caddyfile"
    hosts_override = os.environ.get("LOKL_HOSTS")
    hosts = Path(hosts_override) if hosts_override else Path("/etc/hosts")
    return Paths(caddyfile, caddyfile.parent / "sites", hosts, bool(override or hosts_override))


def normalise(raw):
    """A bare name or a full domain, as (name, domain), or (None, complaint).

    Accepts both spellings because both read naturally at the prompt, and lowercases
    before validating: DNS is case-insensitive, but the file name and the hosts entry
    should have one canonical form.

    `name` is the whole chain below the suffix, so `app.pot` for `app.pot.localhost`, and it
    is also the site file's stem. Every label is validated on its own, because one bad label
    in a chain is a different mistake from a chain that is too long and reads as one.
    """
    name = (raw or "").strip().lower().rstrip(".")
    if name.endswith(f".{SUFFIX}"):
        name = name[: -len(SUFFIX) - 1]
    if not name:
        return None, "Give a project name, as in `lokl add my-custom-project 4321`."
    labels = name.split(".")
    for label in labels:
        if not LABEL.match(label):
            return None, (
                f"{raw!r} is not a usable name: {label!r} is not a DNS label. Use lowercase "
                "letters, digits and hyphens, starting and ending with a letter or digit."
            )
    if len(labels) > MAX_LABELS:
        return None, (
            f"{raw!r} nests too deep. Use at most {MAX_LABELS - 1} subdomain label, as in "
            f"`{labels[-2]}.{labels[-1]}.{SUFFIX}`."
        )
    return name, f"{name}.{SUFFIX}"


def parent_of(domain):
    """The registrable domain a nested name sits under, or None when it is already one."""
    labels = domain.split(".")
    return ".".join(labels[1:]) if len(labels) > MAX_LABELS else None


def domain_sort_key(domain):
    """Sort one project's names together, parent first.

    Reversing the labels puts `pot.localhost` at ("localhost", "pot") ahead of
    `app.pot.localhost` at ("localhost", "pot", "app") and keeps every `*.pot.localhost`
    contiguous, where sorting the names as written files the children under their own initials
    and scatters a project across the list.
    """
    return tuple(reversed(domain.split(".")))


def ordered_domains(configured):
    return sorted(configured, key=domain_sort_key)


def parse_sub(raw):
    """`label` or `label=port`, as ((label, port or None), None), or (None, complaint)."""
    text = (raw or "").strip()
    label, separator, port = text.partition("=")
    label = label.strip().lower()
    if not LABEL.match(label):
        return None, (
            f"{raw!r} is not a usable subdomain. Use one lowercase DNS label, optionally "
            "as `label=port`."
        )
    # A bare `app` asks for a derived port; `app=` asked for a specific one and lost it, which
    # is a typo rather than the same request, so it is refused rather than quietly derived.
    if not separator:
        return (label, None), None
    if not port.strip().isdigit():
        return None, f"{raw!r} names no port. Write it as `{label}=3001`."
    return (label, int(port.strip())), None


def derive_port(seed, taken=()):
    """A stable port for a project, from a digest of `seed`, stepping over `taken`.

    sha256 rather than the built-in `hash`, which is salted per process unless PYTHONHASHSEED
    is pinned, so `hash` would hand out a different port on every run. Any stable digest
    would do and none of this depends on the hash being cryptographic; what it depends on is
    the same directory always giving the same answer.

    A collision walks forward from the hashed slot rather than rehashing, which keeps the
    answer a function of the seed and of what is already assigned. 20000 slots put a
    collision well past the number of projects one machine holds, and probing makes the
    one that does happen invisible. Returns None only when every slot is taken.
    """
    digest = hashlib.sha256(str(seed).encode()).digest()
    start = int.from_bytes(digest[:8], "big") % PORT_SPAN
    blocked = set(taken) | set(RESERVED)
    for step in range(PORT_SPAN):
        candidate = PORT_FLOOR + (start + step) % PORT_SPAN
        if candidate not in blocked:
            return candidate
    return None


def derive_window(seed, count, taken=()):
    """`count` consecutive free ports from `seed`, or None, on `derive_port`'s digest.

    Consecutive rather than each name hashed on its own, because one project's ports are read
    together: 29769-29772 is a range a person holds in their head and an `lsof` sweep can
    name, where four unrelated numbers are four things to look up separately.

    A run never crosses PORT_CEILING and wraps, since a wrapped window is two ranges rather
    than one, which defeats the only reason to derive them together. At `count` 1 this answers
    exactly what `derive_port` answers, which is what keeps a plain `lokl add` unchanged.
    """
    if count < 1:
        return []
    digest = hashlib.sha256(str(seed).encode()).digest()
    start = int.from_bytes(digest[:8], "big") % PORT_SPAN
    blocked = set(taken) | set(RESERVED)
    for step in range(PORT_SPAN):
        first = PORT_FLOOR + (start + step) % PORT_SPAN
        if first + count - 1 > PORT_CEILING:
            continue
        run = range(first, first + count)
        if blocked.isdisjoint(run):
            return list(run)
    return None


def assigned_ports(configured):
    return {site.port for site in configured.values() if site.port}


def render_site(domain, port):
    """One site file, in the exact shape `caddy fmt` produces.

    Both loopback families are listed because a dev server may bind `[::1]` only, as Vite
    and Next both may, and an IPv4-only upstream then answers 502 while `lsof` plainly
    shows the port held. `lb_policy first` is what makes the pair a failover rather than
    the default random selection, which would send about half the requests to whichever
    address nothing is holding. Never `0.0.0.0`: that is a bind address meaning every
    interface, and dialling it times out rather than being refused, so a request stalls
    instead of failing.
    """
    return (
        f"http://{domain} {{\n"
        f"\treverse_proxy {LOOPBACK}:{port} [::1]:{port} {{\n"
        f"\t\tlb_policy first\n"
        f"\t\tfail_duration 5s\n"
        f"\t}}\n"
        f"}}\n"
    )


def parse_site(text):
    """(domain, ports) out of a site file, with either half allowed to be missing.

    A hand-written file that this tool did not generate still gets listed, with its ports
    reported as empty rather than the whole file being ignored. Every port on the line is
    read rather than the first alone, because the first alone is what let a file naming two
    different upstreams read back as clean while the proxy quietly served one of them.
    """
    host = SITE_HOST.search(text)
    if not host:
        return None, ()
    upstreams = SITE_UPSTREAMS.search(text)
    if not upstreams:
        return host.group(1), ()
    found = (UPSTREAM_PORT.search(token) for token in upstreams.group(1).split())
    return host.group(1), tuple(int(match.group(1)) for match in found if match)


def disagreeing(site):
    """The distinct ports a site names, when it names more than one, else ().

    `lb_policy first` makes the pair a failover, so a site naming two different ports serves
    whichever is listed first and reaches the second only once the first refuses. That is a
    silent preference rather than the family failover the pair exists to provide.
    """
    distinct = set(site.ports)
    return tuple(sorted(distinct)) if len(distinct) > 1 else ()


def duplicates(configured):
    """{port: [domain, ...]} for every port more than one domain claims."""
    claimed = collections.defaultdict(list)
    for domain, site in configured.items():
        if site.port:
            claimed[site.port].append(domain)
    return {port: names for port, names in claimed.items() if len(names) > 1}


def sites(directory):
    """Every configured domain, as an ordered {domain: Site}."""
    found = {}
    if not directory.is_dir():
        return found
    for path in sorted(directory.glob("*.caddyfile")):
        try:
            domain, ports = parse_site(path.read_text())
        except OSError:
            continue
        if domain:
            found[domain] = Site(ports[0] if ports else None, path, ports)
    return found


def hosts_block(domains):
    """The managed block, or an empty string when there is nothing to manage."""
    if not domains:
        return ""
    lines = [BEGIN] + [f"{LOOPBACK}\t{domain}" for domain in domains] + [END]
    return "\n".join(lines) + "\n"


def replace_block(content, block):
    """Swap the managed block, append it when absent, or drop it when the block is empty.

    Raises ValueError on a half-marked or doubly-marked file rather than guessing. A BEGIN
    with no END means somebody edited /etc/hosts by hand mid-block, and appending a second
    block there would leave the first one live, resolving names nothing lists any more.
    """
    lines = content.splitlines()
    starts = [i for i, line in enumerate(lines) if line.strip() == BEGIN]
    ends = [i for i, line in enumerate(lines) if line.strip() == END]
    if len(starts) > 1 or len(ends) > 1 or len(starts) != len(ends):
        raise ValueError(
            "the lokl markers in the hosts file are unbalanced, so the managed block "
            "cannot be located. Repair them by hand and run `lokl sync`."
        )
    if starts and ends[0] < starts[0]:
        raise ValueError("the lokl end marker precedes its begin marker in the hosts file.")

    before = lines[: starts[0]] if starts else lines
    after = lines[ends[0] + 1 :] if ends else []
    before = list(before)
    after = list(after)
    while before and not before[-1].strip():
        before.pop()
    while after and not after[0].strip():
        after.pop(0)

    kept = list(before)
    for section in (block.splitlines(), after):
        if not section:
            continue
        if kept:
            kept.append("")
        kept.extend(section)
    return "\n".join(kept) + "\n" if kept else ""


def foreign_entries(content, domains):
    """Hosts entries for our domains that sit outside the managed block.

    The setup this replaces told people to append these by hand, so a machine that followed
    it carries duplicates the block cannot see. Resolution still works, which is why this
    warns rather than refuses, but a stale hand-written line pointing somewhere else is a
    genuinely hard failure to debug.
    """
    wanted = set(domains)
    found = []
    for line in replace_block(content, "").splitlines():
        fields = line.split("#", 1)[0].split()
        if len(fields) >= 2 and wanted.intersection(fields[1:]):
            found.append(" ".join(fields))
    return found


def write_hosts(path, content):
    """Replace the hosts file, escalating only when this user cannot write it.

    `tee` rather than a copy so the file keeps its inode, owner and mode, and sudo reads a
    password from the tty rather than from stdin, so piping the content in is safe. The
    writable branch is not a convenience: it is what lets every command here be driven
    against a tmp_path with no privilege at all.
    """
    if os.access(path, os.W_OK):
        path.write_text(content)
        return None
    try:
        proc = subprocess.run(
            ["sudo", "tee", str(path)], input=content.encode(), stdout=subprocess.DEVNULL
        )
    except FileNotFoundError:
        return "sudo is not on PATH, so the hosts file cannot be written."
    if proc.returncode != 0:
        return f"`sudo tee {path}` exited {proc.returncode}, so the hosts file is unchanged."
    # A name that failed to resolve a moment ago is cached as failing, so a fresh entry
    # reads as ignored until that negative answer lapses.
    subprocess.run(["sudo", "dscacheutil", "-flushcache"], check=False)
    subprocess.run(
        ["sudo", "killall", "-HUP", "mDNSResponder"], check=False, stderr=subprocess.DEVNULL
    )
    return None


def apply_hosts(paths, domains):
    """Converge the hosts file on `domains`. Returns (changed, error, code).

    The two failures are kept apart because they ask for different things: a broken marker
    is a file to repair by hand, and a refused write is a password to retype.
    """
    try:
        current = paths.hosts.read_text()
    except OSError as exc:
        return False, f"cannot read {ui.path(paths.hosts)}: {exc.strerror or exc}", EXIT_PRIVILEGE
    try:
        wanted = replace_block(current, hosts_block(domains))
    except ValueError as exc:
        return False, str(exc), EXIT_INVALID
    if wanted == current:
        return False, None, EXIT_OK
    return True, write_hosts(paths.hosts, wanted), EXIT_PRIVILEGE


def resolves(domain):
    """Every address the system resolver returns for a name, as it would for a dev server."""
    try:
        return sorted({info[4][0] for info in socket.getaddrinfo(domain, None)})
    except socket.gaierror:
        return []


def listening(port):
    """Whether anything holds the port, on either loopback family."""
    if not port:
        return False
    for family, address in ((socket.AF_INET, (LOOPBACK, port)), (socket.AF_INET6, ("::1", port))):
        try:
            with socket.socket(family, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.2)
                if probe.connect_ex(address) == 0:
                    return True
        except OSError:
            continue
    return False


def caddy_running():
    proc = subprocess.run(["pgrep", "-f", "caddy run"], capture_output=True, text=True)
    return proc.returncode == 0


def run_caddy(paths, *args):
    """One caddy invocation against our config. Returns (ok, output)."""
    if shutil.which("caddy") is None:
        return False, "caddy is not on PATH"
    proc = subprocess.run(
        ["caddy", *args, "--config", str(paths.caddyfile)], capture_output=True, text=True
    )
    return proc.returncode == 0, (proc.stderr or proc.stdout).strip()


def validate(paths):
    """Parse the config without touching a running process. Returns a complaint, or None.

    A missing caddy degrades to no check rather than to a refusal: the site file is written
    either way, and refusing to record a domain because the proxy is not installed would
    make the tool useless on a machine that has not run the playbook yet.
    """
    if shutil.which("caddy") is None:
        return None
    ok, output = run_caddy(paths, "validate")
    return None if ok else output


def reload_proxy(paths):
    """Reload a running proxy after a change here, and say nothing when none is running.

    Reload goes through the admin API rather than restarting anything, so an in-flight
    request survives it. That API only exists while Caddy runs, which is why this is gated
    rather than attempted and reported as a failure.

    An overridden config is never pushed. `caddy reload` replaces the running instance's
    whole configuration with the file it is handed, so pointing this tool at some other
    Caddyfile and having it swap the machine's live config for that one is never what the
    override means. An explicit `lokl reload` still does as it is told.
    """
    if paths.overridden:
        ui.note(f"not reloading: {ui.path(paths.caddyfile)} is not the machine's config")
        return
    if not caddy_running():
        ui.note("the proxy is not running, so `lokl start` is what serves this")
        return
    ok, output = run_caddy(paths, "reload")
    if ok:
        ui.ok("reloaded the running proxy")
    else:
        ui.warn(f"the running proxy refused the reload: {output}")


def report_resolution(paths, domain):
    """Confirm the entry took, because every other step succeeding proves nothing.

    This is the one check covering the assumption the whole design rests on: that the name
    resolves at all. Writing the file is not evidence of that, and the failure is silent
    everywhere else.

    Resolving to both loopback families is not a finding. macOS returns the pair for every
    *.localhost name regardless of what the hosts entry lists, so warning about it fired on
    every add and named a condition neither this tool nor the user can change.
    """
    if paths.overridden:
        return EXIT_OK
    addresses = resolves(domain)
    stray = [address for address in addresses if address not in LOOPBACK_ADDRESSES]
    if stray:
        ui.warn(f"{domain} also resolves to {', '.join(stray)}, which is not loopback")
        return EXIT_OK
    if addresses:
        ui.ok(f"{domain} resolves to {', '.join(addresses)}")
        return EXIT_OK
    ui.err(f"{domain} still does not resolve.")
    ui.note("The hosts entry is written, so the system resolver is ignoring it.")
    ui.note("`dscacheutil -q host -a name " + domain + "` shows what it thinks.")
    return EXIT_UNRESOLVED


def plan_members(args):
    """[(domain, name, port or None)] for everything this `add` touches, or (None, complaint).

    The parent comes first, so a derived window hands it the lowest port. That is the number a
    person quotes when naming the project, and it makes the range read upward from it.
    """
    name, domain = normalise(args.name)
    if name is None:
        return None, domain
    subs = args.sub or []
    if subs and "." in name:
        child, _, parent = name.partition(".")
        return None, (
            f"{domain} is already a subdomain, so it cannot carry more. Hang the subdomains "
            f"off the parent instead: `lokl add {parent} --sub {child}`."
        )

    members = [(domain, name, args.port)]
    seen = {domain}
    for raw in subs:
        parsed, complaint = parse_sub(raw)
        if parsed is None:
            return None, complaint
        label, port = parsed
        child = f"{label}.{name}"
        child_domain = f"{child}.{SUFFIX}"
        if child_domain in seen:
            return None, f"`--sub {label}` is named twice."
        seen.add(child_domain)
        members.append((child_domain, child, port))
    return members, None


def assign_ports(members, existing, seed):
    """({domain: port}, derived domains, whether the run is consecutive), or (None, ., complaint).

    A member keeps a port it already has, because re-deriving would let an unrelated project
    taking the hashed slot silently move a domain that was working. That is also why a project
    only gets a consecutive window when every one of its names is new: honouring one recorded
    port and moving the rest would trade a working setup for a tidy range.
    """
    ports = {}
    for domain, _, named in members:
        port = named if named is not None else (existing[domain].port if domain in existing else None)
        if port is not None:
            ports[domain] = port

    pending = [domain for domain, _, _ in members if domain not in ports]
    if not pending:
        return ports, (), False, None

    taken = assigned_ports(existing) | set(ports.values())
    if len(pending) == len(members):
        window = derive_window(seed, len(pending), taken)
        if window is None:
            return None, (), False, (
                f"no run of {len(pending)} consecutive free ports is left in "
                f"{PORT_FLOOR}-{PORT_CEILING}."
            )
        ports.update(zip(pending, window))
        return ports, tuple(pending), len(pending) > 1, None

    for domain in pending:
        port = derive_port(seed, taken)
        if port is None:
            return None, (), False, "every port in the derived range is already assigned."
        ports[domain] = port
        taken = taken | {port}
    return ports, tuple(pending), False, None


def rollback(written):
    """Undo every file an `add` wrote, so a rejected project leaves nothing behind."""
    for path, restore in written:
        if restore is None:
            path.unlink(missing_ok=True)
        else:
            path.write_text(restore)


def cmd_add(args, paths):
    members, complaint = plan_members(args)
    if members is None:
        return fail(EXIT_USAGE, complaint)

    existing = sites(paths.sites)
    previous = {domain: existing[domain].port for domain, _, _ in members if domain in existing}

    ports, derived, consecutive, complaint = assign_ports(members, existing, Path.cwd())
    if ports is None:
        return fail(EXIT_NOT_FOUND, complaint)

    for domain, _, _ in members:
        port = ports[domain]
        if port in RESERVED:
            return fail(EXIT_USAGE, f"Port {port} is unavailable: {RESERVED[port]}.")
        if not 1 <= port <= 65535:
            return fail(EXIT_USAGE, f"Port {port} is outside the usable range.")

    # Never conjured on the machine's own prefix. That path is a symlink the playbook owns,
    # and a real directory sitting there is what `ansible.builtin.file state=link` cannot
    # replace, so creating one here would quietly break the task that repairs it.
    if not paths.sites.is_dir() and not paths.overridden:
        return fail(
            EXIT_NOT_FOUND,
            f"{ui.path(paths.sites)} is missing. Run `make run-role ROLE=apps` to link it.",
        )

    written = []
    try:
        paths.sites.mkdir(parents=True, exist_ok=True)
        for domain, name, _ in members:
            site = paths.sites / f"{name}.caddyfile"
            written.append((site, site.read_text() if site.exists() else None))
            site.write_text(render_site(domain, ports[domain]))
    except OSError as exc:
        rollback(written)
        return fail(EXIT_PRIVILEGE, f"cannot write into {ui.path(paths.sites)}: {exc.strerror or exc}")

    # One validate for the whole set rather than one per name. A rejected file then cannot
    # leave half a project on disk, and a four-service project costs one caddy invocation.
    complaint = validate(paths)
    if complaint:
        rollback(written)
        ui.err("Caddy rejected the config, so nothing was changed.")
        ui.note(complaint)
        return EXIT_INVALID

    family = len(members) > 1
    ui.title(f"🔌 {members[0][0]}")
    for domain, _, _ in members:
        port = ports[domain]
        was = previous.get(domain)
        prefix = f"{domain} " if family else ""
        if was == port:
            ui.note(f"{prefix}already proxying to :{port}")
        elif was is not None:
            ui.step(f"{prefix}repointed from :{was} to :{port}")
        else:
            ui.step(f"{prefix}proxying :80 to :{port}")

    if derived:
        ui.note(f"port{'s' if len(derived) > 1 else ''} derived from {ui.path(Path.cwd())}")
        if consecutive:
            ui.note(f"consecutive from :{ports[members[0][0]]}, so the range is one to remember")
        elif family and len(derived) < len(members):
            ui.note("a name already had a port and kept it, so these are not consecutive")
        for domain in derived:
            if listening(ports[domain]):
                ui.warn(f"something already answers on :{ports[domain]}, so name a port if it is not yours")

    # Warned about rather than refused, here and in `validate`, because two names on one port
    # is occasionally deliberate and always worth knowing.
    ours = {domain for domain, _, _ in members}
    for domain, _, _ in members:
        port = ports[domain]
        for other in ordered_domains(existing):
            if existing[other].port == port and other not in ours:
                ui.warn(f"{other} also points at :{port}, so both serve the same process")
    within = collections.defaultdict(list)
    for domain, _, _ in members:
        within[ports[domain]].append(domain)
    for port, names in sorted(within.items()):
        if len(names) > 1:
            ui.warn(f"{ui.names_or_count(names, 'domain')} all point at :{port}")

    changed, error, code = apply_hosts(paths, ordered_domains(sites(paths.sites)))
    if error:
        return fail(code, error)
    if changed:
        for domain, _, _ in members:
            ui.step(f"added {LOOPBACK}\t{domain} to {ui.path(paths.hosts)}")

    warn_foreign(paths)
    reload_proxy(paths)

    status = EXIT_OK
    for domain, _, _ in members:
        status = status or report_resolution(paths, domain)
    if family:
        ui.done(", ".join(f"http://{domain}" for domain, _, _ in members))
    else:
        domain = members[0][0]
        ui.done(f"http://{domain} and http://{domain}:{ports[domain]}")
    return status


def cmd_remove(args, paths):
    """One domain, or with `--tree` a parent and every subdomain under it.

    The flag is the confirmation. It deletes files the caller did not name, and there is no
    prompt anywhere else in this tool to be consistent with, but the site files are committed,
    so `git checkout` is the undo for a `--tree` aimed at the wrong parent.
    """
    name, domain = normalise(args.name)
    if name is None:
        return fail(EXIT_USAGE, domain)
    existing = sites(paths.sites)
    if domain not in existing:
        return fail(EXIT_NOT_FOUND, f"{domain} is not configured. `lokl list` shows what is.")

    children = [other for other in ordered_domains(existing) if parent_of(other) == domain]
    doomed = [domain] + children if args.tree else [domain]

    ui.title(f"🔌 {domain}")
    for one in doomed:
        target = existing[one].path
        try:
            target.unlink()
        except OSError as exc:
            return fail(EXIT_PRIVILEGE, f"cannot remove {ui.path(target)}: {exc.strerror or exc}")
        ui.step(f"removed {ui.path(target)}")
    if children and not args.tree:
        ui.note(
            f"{ui.names_or_count(children, 'domain')} still sit under it. "
            f"`lokl remove {name} --tree` takes those too."
        )

    changed, error, code = apply_hosts(paths, ordered_domains(sites(paths.sites)))
    if error:
        return fail(code, error)
    if changed:
        if len(doomed) > 1:
            ui.step(f"dropped their entries from {ui.path(paths.hosts)}")
        else:
            ui.step(f"dropped its entry from {ui.path(paths.hosts)}")

    reload_proxy(paths)
    if len(doomed) > 1:
        ui.done(f"{ui.names_or_count(doomed, 'domain')} removed")
    else:
        ui.done(f"{domain} removed")
    return EXIT_OK


def warn_foreign(paths):
    try:
        stray = foreign_entries(paths.hosts.read_text(), sorted(sites(paths.sites)))
    except (OSError, ValueError):
        return
    for line in stray:
        ui.warn(f"{ui.path(paths.hosts)} also carries `{line}` outside the managed block")


def cmd_port(args, paths):
    """Print one port and nothing else, so a shell can read it.

    The only command here whose stdout is a value rather than a report, which is why it
    carries no glyph and no colour: `astro dev --port (lokl port my-custom-project)` cannot be
    handed a decorated line. `claude-kit list --json` holds the same exemption for the same
    reason, that its whole content is a fact rather than an account of what a command did.

    A configured domain answers from its site file rather than from the hash. That is the
    number the proxy is actually pointing at, it is stable across machines because the site
    file is committed, and it does not move when another project takes the hashed slot.
    Naming the domain is therefore the form to use in a script; the bare form answers for
    the working directory, which is what `lokl add` would assign there.
    """
    configured = sites(paths.sites)
    if args.name:
        name, domain = normalise(args.name)
        if name is None:
            return fail(EXIT_USAGE, domain)
        if domain in configured:
            port = configured[domain].port
            if port is None:
                return fail(EXIT_NOT_FOUND, f"{domain} carries no reverse_proxy port to read.")
            print(port)
            return EXIT_OK

    # The unprobed slot for this directory, which is the number `lokl add` derived here the
    # first time. Threading the taken set in unconditionally counted a domain's own recorded
    # port as somebody else's and stepped one past it, so this printed a port the proxy points
    # nowhere near while `lokl port <name>` printed the right one.
    slot = derive_port(Path.cwd())
    holders = [domain for domain, site in configured.items() if site.port == slot]
    if holders:
        # A genuine collision would put an unrelated project on this slot, and no record here
        # says which directory a domain was added from, so the note names the holder rather
        # than pretending the inference is certain. stderr, because stdout carries the value.
        for domain in holders:
            ui.note(
                f"{domain} already holds :{slot}; `lokl port {domain}` reads its file.",
                stream=sys.stderr,
            )
        print(slot)
        return EXIT_OK

    port = derive_port(Path.cwd(), assigned_ports(configured))
    if port is None:
        return fail(EXIT_NOT_FOUND, "every port in the derived range is already assigned.")
    print(port)
    return EXIT_OK


def cmd_list(args, paths):
    configured = sites(paths.sites)
    if not configured:
        ui.title("🔌 Development domains")
        ui.note("none configured yet. `lokl add my-custom-project 4321` is the first one.")
        ui.done("0 domains")
        return EXIT_OK

    try:
        hosts_text = paths.hosts.read_text()
    except OSError:
        hosts_text = ""
    # Every name on every entry, not just the first: a hosts line may carry several
    # aliases against one address, and reading only the first reports a domain as
    # missing while it resolves perfectly well.
    resolved = set()
    for line in hosts_text.splitlines():
        fields = line.split("#", 1)[0].split()
        if len(fields) >= 2:
            resolved.update(fields[1:])

    ui.title("🔌 Development domains")
    # A subdomain is indented under its parent, so the width has to be measured on what the
    # row actually occupies rather than on the name alone, or the port column steps in and out.
    inset = {domain: NEST_INDENT if parent_of(domain) in configured else 0 for domain in configured}
    width = max(len(domain) + inset[domain] for domain in configured)
    serving = 0
    for domain in ordered_domains(configured):
        site = configured[domain]
        indent = inset[domain]
        port = site.port
        split = disagreeing(site)
        target = f":{port}" if port else "unparsed"
        if split:
            state, colour = "upstreams disagree", "red"
        elif port and listening(port):
            state, colour = "serving", "green"
            serving += 1
        elif port:
            state, colour = "nothing listening", "dim"
        else:
            state, colour = "no reverse_proxy line", "yellow"
        shown = domain.ljust(width - indent)
        row = f"{ui.paint(shown, 'cyan')}  {target.ljust(7)} {ui.paint(state, colour)}"
        ui.item(row, indent=ITEM_INDENT + indent)
        if split:
            named = " and ".join(f":{one}" for one in split)
            ui.note(
                f"names {named}, so only :{port} is served until it refuses. "
                f"`lokl add {domain} <port>` rewrites it.",
                indent=4,
            )
        if domain not in resolved:
            ui.note(f"no hosts entry, so nothing here lists {domain}. Run `lokl sync`.", indent=4)

    for port, names in sorted(duplicates(configured).items()):
        ui.warn(f":{port} is claimed by {ui.names_or_count(names, 'domain')}, so both serve one process")

    ui.blank()
    ui.done(f"{len(configured)} domain{'' if len(configured) == 1 else 's'}, {serving} serving")
    return EXIT_OK


def cmd_sync(args, paths):
    configured = ordered_domains(sites(paths.sites))
    ui.title("🔄 Reconciling the hosts file with the site files")
    changed, error, code = apply_hosts(paths, configured)
    if error:
        return fail(code, error)
    for domain in configured:
        ui.item(domain)
    warn_foreign(paths)
    if not changed:
        ui.done(f"already in sync, {len(configured)} domain{'' if len(configured) == 1 else 's'}")
        return EXIT_OK
    ui.done(f"wrote {len(configured)} domain{'' if len(configured) == 1 else 's'} to {ui.path(paths.hosts)}")
    return EXIT_OK


def cmd_start(args, paths):
    """Bind :80, which needs root, and daemonize without registering anything at boot.

    Caddy's own `start` writes nothing anywhere, which is the whole reason it is used here
    rather than `brew services`: the latter refuses `run` as root outright, and its `start`
    writes a LaunchDaemon whose RunAtLoad brings the proxy up with the machine.
    """
    if not paths.caddyfile.exists():
        return fail(
            EXIT_NOT_FOUND,
            f"{ui.path(paths.caddyfile)} is missing. Run `make run-role ROLE=apps` first.",
        )
    if caddy_running():
        ui.ok("the proxy is already running")
        ui.done("nothing to do")
        return EXIT_OK
    proc = subprocess.run(["sudo", "caddy", "start", "--config", str(paths.caddyfile)])
    if proc.returncode != 0:
        return fail(EXIT_INVALID, f"`caddy start` exited {proc.returncode}.")
    ui.done("the proxy is serving :80")
    return EXIT_OK


def cmd_stop(args, paths):
    if not caddy_running():
        ui.note("the proxy is not running")
        ui.done("nothing to do")
        return EXIT_OK
    proc = subprocess.run(["caddy", "stop"])
    if proc.returncode != 0:
        return fail(EXIT_INVALID, f"`caddy stop` exited {proc.returncode}.")
    ui.done("the proxy is stopped")
    return EXIT_OK


def cmd_status(args, paths):
    ui.title("🔌 Proxy")
    configured = sites(paths.sites)
    proc = subprocess.run(["pgrep", "-lf", "caddy run"], capture_output=True, text=True)
    if proc.returncode == 0:
        for line in proc.stdout.strip().splitlines():
            ui.ok(line.strip())
    else:
        ui.note("not running. `lokl start` binds :80.")
        # Spelled out because a ported URL still answering is what makes a stopped proxy look
        # like a running one: the port reaches the dev server whatever name is in front of it,
        # and only the portless form puts Caddy in the path.
        ui.note("http://<domain> needs it; http://<domain>:<port> reaches the dev server direct.")

    broken = {domain for domain, site in configured.items() if disagreeing(site)}
    broken.update(domain for names in duplicates(configured).values() for domain in names)
    if broken:
        ui.warn(f"{ui.names_or_count(sorted(broken), 'domain')} misconfigured. Run `lokl validate`.")

    count = len(configured)
    ui.done(f"{count} domain{'' if count == 1 else 's'} configured")
    return EXIT_OK


def cmd_reload(args, paths):
    if not caddy_running():
        return fail(EXIT_NOT_FOUND, "the proxy is not running, so there is nothing to reload.")
    ok, output = run_caddy(paths, "reload")
    if not ok:
        return fail(EXIT_INVALID, output or "`caddy reload` failed.")
    ui.done("reloaded")
    return EXIT_OK


def cmd_validate(args, paths):
    if shutil.which("caddy") is None:
        return fail(EXIT_NOT_FOUND, "caddy is not on PATH.")
    complaint = validate(paths)
    if complaint:
        ui.err("the config does not parse.")
        ui.note(complaint)
        return EXIT_INVALID

    # Caddy accepts both of these, so they are lokl's to catch. A shared port is a choice
    # `add` already only warns about, but a site naming two different upstreams is a shape
    # `render_site` cannot produce, so it is never deliberate.
    configured = sites(paths.sites)
    for port, names in sorted(duplicates(configured).items()):
        ui.warn(f":{port} is claimed by {ui.names_or_count(names, 'domain')}")
    split = {domain: disagreeing(site) for domain, site in configured.items()}
    split = {domain: ports for domain, ports in split.items() if ports}
    if split:
        ui.err("a site names two upstream ports, which `lokl add` never writes.")
        for domain, ports in sorted(split.items()):
            ui.note(f"{domain}: {' and '.join(f':{one}' for one in ports)}", indent=2)
        return EXIT_INVALID

    # Not an error: a subdomain proxies perfectly well with no parent configured. But nesting
    # is only worth doing for the shared cookie jar, and a missing parent is usually a typo in
    # the one name that was supposed to hold it.
    for domain in ordered_domains(configured):
        parent = parent_of(domain)
        if parent and parent not in configured:
            ui.note(f"{domain} serves, but {parent} is not configured, which is usually a typo.")

    ui.done(f"{ui.path(paths.caddyfile)} is valid")
    return EXIT_OK


COMMANDS = {
    "add": cmd_add,
    "remove": cmd_remove,
    "port": cmd_port,
    "list": cmd_list,
    "sync": cmd_sync,
    "start": cmd_start,
    "stop": cmd_stop,
    "status": cmd_status,
    "reload": cmd_reload,
    "validate": cmd_validate,
}


class Parser(argparse.ArgumentParser):
    """argparse exits 2 on a usage error; this script defines its own codes."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, ui.render("err", message, stream=sys.stderr) + "\n")


def build_parser():
    parser = Parser(prog="lokl", description=__doc__.splitlines()[0])
    subparsers = parser.add_subparsers(dest="command", metavar="<command>")

    add = subparsers.add_parser("add", help="serve a project on http://<name>.localhost")
    add.add_argument("name", help="the project name, with or without the .localhost suffix")
    add.add_argument(
        "port",
        type=int,
        nargs="?",
        help="the port the dev server binds; derived from this directory when omitted",
    )
    add.add_argument(
        "--sub",
        action="append",
        metavar="LABEL[=PORT]",
        help="a service under this project, as `app` or `app=3001`; repeatable, and the "
        "derived ports come out consecutive",
    )

    remove = subparsers.add_parser("remove", help="drop a domain and its hosts entry")
    remove.add_argument("name", help="the project name")
    remove.add_argument(
        "--tree", action="store_true", help="drop every subdomain under it as well"
    )

    port = subparsers.add_parser("port", help="print a domain's port, for a dev script to read")
    port.add_argument(
        "name", nargs="?", help="the project name; without one, the port for this directory"
    )

    subparsers.add_parser("list", help="every domain, its port, and whether it answers")
    subparsers.add_parser("sync", help="rewrite the hosts block from the site files")
    subparsers.add_parser("start", help="bind :80 (needs sudo), without touching boot")
    subparsers.add_parser("stop", help="stop the proxy")
    subparsers.add_parser("status", help="whether the proxy runs, and how many domains exist")
    subparsers.add_parser("reload", help="reload a site change into the running proxy")
    subparsers.add_parser("validate", help="parse the config without touching the proxy")
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return EXIT_USAGE
    return COMMANDS[args.command](args, resolve_paths())


if __name__ == "__main__":
    sys.exit(main())
