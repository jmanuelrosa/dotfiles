set -x NPM_TOKEN {{ NPM_TOKEN }}

# Read by both wrangler and cf. cf resolves this before its own OAuth profiles,
# so neither CLI needs a login step.
set -x CLOUDFLARE_API_TOKEN {{ CLOUDFLARE_API_TOKEN }}

# Needed explicitly once the token can see more than one account.
set -x CLOUDFLARE_ACCOUNT_ID {{ CLOUDFLARE_ACCOUNT_ID }}
