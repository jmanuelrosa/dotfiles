set -x NPM_TOKEN {{ NPM_TOKEN }}

# One Cloudflare token under two names, because the CLIs never agreed on one:
# flarectl reads CF_API_TOKEN, while wrangler, cf-terraforming and the OpenTofu
# Cloudflare provider read CLOUDFLARE_API_TOKEN. Setting only one silently leaves
# half the tooling unauthenticated.
set -x CLOUDFLARE_API_TOKEN {{ CLOUDFLARE_API_TOKEN }}
set -x CF_API_TOKEN $CLOUDFLARE_API_TOKEN

# wrangler needs the account explicitly once the token can see more than one.
set -x CLOUDFLARE_ACCOUNT_ID {{ CLOUDFLARE_ACCOUNT_ID }}
