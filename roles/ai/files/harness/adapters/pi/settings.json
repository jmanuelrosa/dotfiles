{
  "collapseChangelog": false,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 10000,
    "reserveTokens": 8192
  },
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "anthropic/claude-opus-5": "xhigh",
    "anthropic/claude-sonnet-5": "xhigh",
    "openai-codex/gpt-6.1-sol": "xhigh",
    "openai-codex/gpt-6-sol": "xhigh",
    "openai-codex/gpt-6-luna": "xhigh",
    "openai-codex/gpt-5.6-sol": "xhigh",
    "openai-codex/gpt-5.6-terra": "xhigh"
  },
  "doubleEscapeAction": "tree",
  "editorPaddingX": 2,
  "enableAnalytics": false,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "cursor/composer-latest",
    "cursor/grok-4.7@256k",
    "cursor/grok-4.7@500k",
    "cursor/grok-4.6",
    "cursor/kimi-k3",
    "cursor/glm-5p3",
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-opus-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-haiku-4-5",
    "google/gemini-3.6-pro",
    "google/gemini-3.6-flash",
    "ollama-cloud/nemotron-3-ultra",
    "ollama-cloud/gpt-oss:120b",
    "xai/grok-4.6",
    "xai/grok-4.5",
    "xai/grok-build-0.1"
  ],
  "extensions": [
    "+builtin:mcp",
    "+builtin:codemode"
  ],
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": true,
  "lastChangelogVersion": "1.0.2",
  "defaultTools": [
