{
  "pre_tool": [
    {
      "id": "git-skill-gate",
      "tools": [
        "bash"
      ],
      "kind": "gate",
      "script": "git-skill-gate.sh"
    },
    {
      "id": "cloud-readonly-gate",
      "tools": [
        "bash"
      ],
      "kind": "gate",
      "script": "cloud-readonly-gate.sh"
    },
    {
      "id": "cli-egress-gate",
      "tools": [
        "bash"
      ],
      "kind": "gate",
      "script": "cli-egress-gate.sh"
    },
    {
      "id": "agent-dispatch-gate",
      "tools": [
        "subagent"
      ],
      "kind": "gate",
      "script": "agent-dispatch-gate.sh"
    },
    {
      "id": "pre-commit-verify",
      "tools": [
        "bash"
      ],
      "kind": "gate",
      "script": "pre-commit-verify.sh",
      "timeout": 180
    },
    {
      "id": "rtk",
      "tools": [
        "bash"
      ],
      "kind": "rewrite",
      "exec": [
        "rtk",
        "hook",
        "claude"
      ],
      "requires_env": "RTK_ENABLE",
      "env": {
        "RTK_HOOK_AUDIT": "1"
      }
    },
    {
      "id": "em-dash-gate",
      "tools": [
        "write",
        "edit"
      ],
      "kind": "gate",
      "script": "em-dash-gate.sh"
    }
  ],
  "session_start": [
    {
      "id": "kura-converge",
      "kind": "gate",
      "command": "if [ -f ./kura.json ]; then ~/.local/bin/kura converge --quiet; fi",
      "timeout": 10
    }
  ],
  "prompt_submit": [
    {
      "id": "dependency-skill-gate",
      "kind": "gate",
      "script": "dependency-skill-gate.sh"
    },
    {
      "id": "context-nudge",
      "kind": "gate",
      "script": "context-nudge.sh",
      "timeout": 10
    }
  ],
  "stop": [
    {
      "id": "skill-recap",
      "kind": "gate",
      "script": "skill-recap.sh"
    }
  ]
}
