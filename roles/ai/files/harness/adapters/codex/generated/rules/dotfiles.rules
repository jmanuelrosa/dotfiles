# Rendered by harness-build from policy/permissions.toml. Edit there, never here.
# Each rule is a token prefix: anything after it matches too.

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "denied by dotfiles policy: dd *",
)

