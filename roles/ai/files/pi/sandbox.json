{
  "enabled": true,
  "network": {
    "allowedDomains": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "sentry.io",
      "*.sentry.io",
      "github.com",
      "api.github.com",
      "gitlab.com",
      "*.githubusercontent.com",
      "auth.atlassian.com",
      "as.atlassian.com",
      "api.atlassian.com",
      "app.fossa.com",
      "developers.notion.com",
      "api.notion.com",
      "context7.com",
      "*.context7.com",
      "api.anthropic.com"
    ],
    "allowLocalBinding": true
  },
  "filesystem": {
    "allowWrite": [
      ".",
      "/tmp",
      "~/.bun/install/cache",
      "~/.npm/_cacache",
      "~/.npm/_npx",
      "~/.cache/uv",
      "/var/folders"
    ],
    "allowRead": [
      "~/.config/gh",
      "~/.lima",
      "~/.gitconfig",
      "~/.ssh/known_hosts",
      "~/.config/acli"
    ],
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.npmrc",
      "~/.netrc",
      "~/.config/gcloud",
      "~/.terraform.d/credentials.tfrc.json",
      "~/.ssh/**",
      "~/.gnupg/**",
      "~/.config/npm/**",
      "~/.pnpmrc",
      "~/.yarnrc",
      "~/.yarnrc.yml",
      "/**/.env",
      "/**/.env.local",
      "/**/.env.*.local",
      "/**/.env.staging",
      "/**/.env.production",
      "/**/.env.test",
      "/**/.env.prod",
      "/**/.env.dev",
      "/**/.env.development",
      "/**/*.pem",
      "/**/*.key",
      "/**/*-key.json",
      "/**/secrets/**",
      "/**/*.p12",
      "/**/*.pfx",
      "/**/*.jks",
      "/**/credentials/**",
      "/**/credentials.json",
      "~/.git-credentials",
      "~/.gitconfig",
      "~/.aws/**",
      "~/.config/gcloud/**",
      "~/.config/terraform/**",
      "~/.terraform.d/**",
      "/**/.terraform.tfstate*",
      "~/.terraformrc",
      "~/.docker/config.json",
      "~/.config/Code/User/globalStorage/**",
      "~/.zsh_history",
      "/**/service-account*.json"
    ],
    "denyWrite": [
      "~/.ssh/**",
      "~/.gnupg/**",
      "~/.npmrc",
      "~/.config/npm/**",
      "~/.pnpmrc",
      "~/.yarnrc",
      "~/.yarnrc.yml",
      "/**/package-lock.json",
      "/**/pnpm-lock.yaml",
      "/**/yarn.lock",
      "/**/.env",
      "/**/.env.local",
      "/**/.env.*.local",
      "/**/.env.staging",
      "/**/.env.production",
      "/**/.env.test",
      "/**/.env.prod",
      "/**/.env.dev",
      "/**/.env.development",
      "/**/*.pem",
      "/**/*.key",
      "/**/*-key.json",
      "/**/secrets/**",
      "/**/*.p12",
      "/**/*.pfx",
      "/**/*.jks",
      "~/.netrc",
      "/**/credentials/**",
      "/**/credentials.json",
      "~/.git-credentials",
      "~/.gitconfig",
      "~/.aws/**",
      "~/.config/gcloud/**",
      "~/.config/acli/**",
      "~/.config/terraform/**",
      "~/.terraform.d/**",
      "/**/.terraform.tfstate*",
      "~/.terraformrc",
      "~/.docker/config.json",
      "~/.config/Code/User/globalStorage/**",
      "~/.zsh_history",
      "/**/service-account*.json"
    ]
  }
}
