#!/usr/bin/env python3
"""What a stretch of agent work cost, read back off the session transcripts.

Claude Code writes one JSONL per session under ~/.claude/projects/<slug>/, and every
assistant record carries a `message.usage` block plus the `attributionSkill` that was
active when it was produced. That is enough to price work after the fact and to say
which skill or agent spent it, which is the only way to compare two workflows without
guessing.

    tokencost                                    the projects available
    tokencost my-custom-project --sessions            one row per session, oldest first
    tokencost my-custom-project                       cost per attribution bucket
    tokencost my-custom-project --session <id>        one session only
    tokencost my-custom-project --match product-team  a subtotal over the buckets that match
    tokencost my-custom-project --context             peak and final context, by session and bucket
    tokencost my-custom-project --pi                  the same, over pi's transcripts

The project is named by any substring that identifies one directory under
~/.claude/projects. That is not sugar: a slug is the project's absolute path with the
separators replaced, so every one of them begins with `-` and argparse would read the
full name as a flag.

**`--pi` reads pi's transcripts instead**, from ~/.pi/agent/sessions/<slug>/, and every
question above is asked the same way of them. One tool rather than two, because the
questions are identical and the difference is a reader: `walk` and `walk_pi` both yield
the same Event, and everything downstream of them is shared. Three things do differ, and
each is a fact about pi rather than a choice made here:

  - **Pi records the cost, so nothing is priced from a table.** Every response carries
    `usage.cost.total` in USD, computed by pi against the catalog that served the
    request. Reading it is not merely easier, it is the only correct answer available: a
    third of the models on this machine are reached through a Cursor or Codex
    subscription and two are local, and RATES below could only ever have guessed at
    those. Its `tier()` defaults *up* to opus, so a table-priced local run would have
    read as the most expensive work in the project. A response that somehow carries no
    recorded cost counts as zero and is named in the closing note, so a gap is visible
    rather than invented.
  - **The bucket is `provider/model`, since pi has no attribution.** That is the axis
    worth having here anyway: pi exists to run several models, and the same model id
    reached through two providers (`cursor/grok-4.6` and `xai/grok-4.6`) is two different
    prices for the same work. Folding them by id would hide the one comparison the
    multi-model setup is for.
  - **A compaction is spend, not just a boundary.** Claude's `compact_boundary` carries
    no usage; pi's `compaction` and `branch_summary` entries carry the summarising call's
    own, so it is counted, under a bucket named for the act rather than the model, which
    the entry does not record.

`--context` answers the other half of the question off the same records. The prompt
handed to the model at a request is `input + cache_read + cache_creation`, so the
maximum of that over a session is the peak context the session reached, and a
compaction boundary states the figure itself in `compactMetadata.preTokens` and is
folded in as a candidate. No percentage of a window is printed: nothing on a transcript
says which window was in force, and a 1M-window session sits in the same tree as a
200k one.

Three things it deliberately does not do. It never groups subagent transcripts under a
guessed agent name: the bucket comes from the `agentType` the `.meta.json` sidecar
states, and falls back to the transcript stem verbatim when there is no sidecar, because
parsing a slug out of the filename is how a first attempt at this counted four unrelated
agents as pipeline cost. A teammate is bucketed `team:` and a plain dispatch `agent:`,
since the two are worth different money and are turned off by different decisions. It
counts a response once rather than once per content block, and reads only the
top-level `usage` rather than the `iterations` list nested inside it: both repeat the
same counts, and the first of them inflated every figure this tool printed by the block
count until it was deduped by request. And it prices nothing it cannot see a TTL for
without saying so: the closing note reports how many cache-write tokens fell back to
the assumed TTL, so a run whose transcripts predate the `cache_creation` breakdown is
visibly less certain rather than quietly wrong.
"""

import argparse
import json
import sys
from collections import defaultdict, namedtuple
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dotkit import ui

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_NOT_FOUND = 2

# USD per million tokens, (input, output), from Anthropic list pricing as of 2026-06-24.
# External facts with no runtime source, so they are stated once here rather than
# derived. Sonnet 5 carries a $2/$10 introductory rate through 2026-08-31 that this
# table does not model: a promotional window would need pricing per message date, and
# every comparison these figures serve is Opus-dominated. A Sonnet-heavy run priced
# here is therefore an upper bound.
RATES = {
    "fable": (10.0, 50.0),
    "opus": (5.0, 25.0),
    "sonnet": (3.0, 15.0),
    "haiku": (1.0, 5.0),
}

# Multipliers on the model's input rate. A 1-hour cache write costs 2x fresh input and
# a 5-minute write 1.25x; a read of either costs 0.1x.
WRITE_MULTIPLIER = {"1h": 2.0, "5m": 1.25}
READ_MULTIPLIER = 0.10

TOKEN_CLASSES = (
    "input_tokens",
    "cache_creation_input_tokens",
    "cache_read_input_tokens",
    "output_tokens",
)

# The prompt the model was handed, which is the context in force at that request. Output
# is excluded: it is what came back, not what was carried.
CONTEXT_CLASSES = TOKEN_CLASSES[:-1]

UNATTRIBUTED = "<unattributed>"

# What a bucket means, which is the one thing the two harnesses disagree about in the
# output. Claude buckets by the skill or agent that was active; pi has no attribution and
# buckets by the model that answered.
BUCKET_LABEL = "attribution bucket"
PI_BUCKET_LABEL = "provider/model"

# `context` holds the prompt size for a usage event and `compactMetadata.preTokens` for
# a compaction one, which is the same quantity stated by the harness rather than summed.
#
# `cost` is the USD the harness itself recorded, or None when it records none and the
# rate table has to answer. It is the seam between the two readers: Claude states token
# counts and leaves pricing to us, pi states the price. None rather than 0.0, because a
# free local model legitimately costs nothing and must not read as unpriced.
Event = namedtuple("Event", "kind bucket model usage session stamp context sidechain cost")


def projects_root(home=None):
    return Path(home or Path.home()) / ".claude" / "projects"


def pi_root(home=None):
    """Pi's transcripts. Same shape as Claude's: one directory per project, slugged."""
    return Path(home or Path.home()) / ".pi" / "agent" / "sessions"


def tier(model):
    """Which rate row a model id falls in, defaulting to the most expensive.

    Defaulting up rather than down keeps an unrecognised model from making a run look
    cheap, which is the failure mode that matters when the number is used to choose
    between two workflows.
    """
    lowered = (model or "").lower()
    for name in RATES:
        if name in lowered:
            return name
    return "opus"


def price(usage, model, assumed_ttl):
    """(usd, tokens_priced_by_assumption) for one usage block."""
    rate_in, rate_out = RATES[tier(model)]
    breakdown = usage.get("cache_creation") or {}
    long_write = breakdown.get("ephemeral_1h_input_tokens", 0)
    short_write = breakdown.get("ephemeral_5m_input_tokens", 0)

    assumed = 0
    if not (long_write or short_write):
        assumed = usage.get("cache_creation_input_tokens", 0)
        if assumed_ttl == "1h":
            long_write = assumed
        else:
            short_write = assumed

    micros = (
        usage.get("input_tokens", 0) * rate_in
        + long_write * rate_in * WRITE_MULTIPLIER["1h"]
        + short_write * rate_in * WRITE_MULTIPLIER["5m"]
        + usage.get("cache_read_input_tokens", 0) * rate_in * READ_MULTIPLIER
        + usage.get("output_tokens", 0) * rate_out
    )
    return micros / 1e6, assumed


def agent_meta(path):
    """The sidecar Claude Code writes beside a subagent transcript, or {}.

    Undocumented, so it is read defensively and its absence is a fallback rather
    than an error: an older session, or a layout change, degrades to the stem.
    """
    try:
        data = json.loads(path.with_name(path.stem + ".meta.json").read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def bucket_of(record, path, is_sidechain):
    if is_sidechain:
        meta = agent_meta(path)
        name = meta.get("agentType") or path.stem
        # A teammate and a plain dispatch of the same seat cost differently and are
        # decided differently, so they are never summed into one row.
        prefix = "team" if meta.get("taskKind") == "in_process_teammate" else "agent"
        return f"{prefix}:{name}"
    return record.get("attributionSkill") or UNATTRIBUTED


def session_of(path):
    """The session a transcript belongs to, whether it is the session's own or a subagent's.

    A subagent transcript sits at <session-id>/subagents/agent-<slug>-<hash>.jsonl, so
    the id is a grandparent directory rather than the stem.
    """
    if "subagents" in path.parts:
        return path.parent.parent.name
    return path.stem


def walk(project_dir, session=None, since=None):
    """Yield an Event per priced assistant record and per compaction boundary.

    Deduped by request, which is the whole reason this is not a filter over lines.
    Claude Code writes one line per content block of a reply and repeats the identical
    `usage` on every one of them, so a response carrying a thinking block and two tool
    calls appears three times over. The key falls back to `message.id` and then to the
    line's position, so a record carrying neither identifier is still counted once
    rather than folded into its neighbours.
    """
    for path in sorted(project_dir.rglob("*.jsonl")):
        session_id = session_of(path)
        if session and session_id != session:
            continue
        is_sidechain = "subagents" in path.parts
        seen = set()
        for position, line in enumerate(path.read_text(errors="replace").splitlines()):
            try:
                record = json.loads(line)
            except ValueError:
                continue
            stamp = record.get("timestamp") or ""
            # A record with no timestamp is kept rather than dropped: --since is a
            # filter on known-old work, not a licence to discard what it cannot date.
            if since and stamp and stamp[:10] < since:
                continue
            if record.get("type") == "system" and record.get("subtype") == "compact_boundary":
                pre = (record.get("compactMetadata") or {}).get("preTokens") or 0
                yield Event("compact", None, "", None, session_id, stamp, pre, is_sidechain, None)
                continue
            if record.get("type") != "assistant":
                continue
            message = record.get("message") or {}
            usage = message.get("usage")
            if not usage:
                continue
            key = record.get("requestId") or message.get("id") or position
            if key in seen:
                continue
            seen.add(key)
            marked = is_sidechain or bool(record.get("isSidechain"))
            yield Event(
                "usage",
                bucket_of(record, path, marked),
                message.get("model", ""),
                usage,
                session_id,
                stamp,
                sum(usage.get(name, 0) for name in CONTEXT_CLASSES),
                marked,
                # Claude states counts and leaves the pricing to RATES.
                None,
            )


# Pi's usage keys, mapped onto the ones every function below already speaks. Normalising
# at the reader rather than teaching the tables two vocabularies is what keeps the whole
# of collect(), the three printers and --json shared between the harnesses.
#
# `reasoning` is deliberately absent: pi reports it beside `output` but its `totalTokens`
# is input + output alone, so it is already counted inside output and adding it would
# inflate every reasoning model's volume.
PI_TOKEN_KEYS = (
    ("input", "input_tokens"),
    ("cacheWrite", "cache_creation_input_tokens"),
    ("cacheRead", "cache_read_input_tokens"),
    ("output", "output_tokens"),
)

# The two entries that spend money without being a reply. Named for the act because the
# entry records no model, and a bucket claiming one would be a guess.
PI_SUMMARY_BUCKETS = {"compaction": "<compaction>", "branch_summary": "<branch summary>"}


def pi_session_of(path):
    """`2026-08-13T13-19-06-968Z_019ffb46-....jsonl` -> the uuid after the stamp.

    The uuid alone, because that is what `pi --session` and `--resume` accept, so a row
    in this table can be pasted straight back into pi. The timestamp prefix is what pi
    sorts the files by and is recovered from the records' own stamps anyway.
    """
    _, _, tail = path.stem.partition("_")
    return tail or path.stem


def pi_usage(usage):
    return {ours: usage.get(theirs) or 0 for theirs, ours in PI_TOKEN_KEYS}


def pi_cost(usage):
    """The USD pi recorded, or None when the record carries none."""
    recorded = (usage.get("cost") or {}).get("total")
    return float(recorded) if isinstance(recorded, (int, float)) else None


def walk_pi(project_dir, session=None, since=None):
    """Yield an Event per pi response, and per compaction or branch summary.

    Deduped by entry id rather than by request, and for a different reason than `walk`:
    pi writes one record per response, holding every content block, so there is nothing
    to fold. What there is instead is forking and resuming, which can write a parent's
    entries into a second file under the same project; an id is the only thing that makes
    a copied entry recognisable as the same spend. A record with no id is kept.

    Abandoned branches are counted, and that is not an oversight. A session file holds a
    tree rather than a list, and a branch the user backed out of was still paid for.
    """
    seen = set()
    for path in sorted(project_dir.rglob("*.jsonl")):
        session_id = pi_session_of(path)
        if session and session_id != session:
            continue
        for line in path.read_text(errors="replace").splitlines():
            try:
                record = json.loads(line)
            except ValueError:
                continue
            kind = record.get("type")
            if kind not in PI_SUMMARY_BUCKETS and kind != "message":
                continue
            stamp = record.get("timestamp") or ""
            if since and stamp and stamp[:10] < since:
                continue
            identity = record.get("id")
            if identity is not None:
                if identity in seen:
                    continue
                seen.add(identity)

            if kind == "message":
                message = record.get("message") or {}
                if message.get("role") != "assistant":
                    continue
                usage = message.get("usage")
                if not usage:
                    continue
                model = message.get("model") or "?"
                provider = message.get("provider") or "?"
                yield Event(
                    "usage",
                    f"{provider}/{model}",
                    model,
                    pi_usage(usage),
                    session_id,
                    stamp,
                    sum(usage.get(theirs) or 0 for theirs, _ in PI_TOKEN_KEYS[:-1]),
                    False,
                    pi_cost(usage),
                )
                continue

            # `tokensBefore` is the context the summary was taken from, which is pi's
            # statement of the same quantity Claude's preTokens gives.
            before = record.get("tokensBefore") or 0
            if kind == "compaction" and before:
                yield Event("compact", None, "", None, session_id, stamp, before, False, None)
            usage = record.get("usage")
            if usage:
                yield Event(
                    "usage",
                    PI_SUMMARY_BUCKETS[kind],
                    "",
                    pi_usage(usage),
                    session_id,
                    stamp,
                    sum(usage.get(theirs) or 0 for theirs, _ in PI_TOKEN_KEYS[:-1]),
                    False,
                    pi_cost(usage),
                )


def raise_peak(row, value):
    row["peak"] = value if row["peak"] is None else max(row["peak"], value)


def collect(events, assumed_ttl, recorded=False):
    """Fold a reader's events into the views the printers read.

    Takes the events rather than a directory, which is what lets one implementation serve
    both harnesses: the reader decides what a bucket is and what a cost is, and everything
    here is arithmetic over whatever it yielded.

    `recorded` says the harness prices its own work, which decides what a missing cost
    means. With it, a gap is a gap and lands in `unpriced`; without it, the rate table is
    the answer and always has one. The flag rather than "cost is None" alone, because
    those two are the same value and opposite situations.

    The model tier is only collected when it was used to price, so pi's buckets carry no
    tier: they name the model already, and `tier()` defaults up to opus, which would
    label every local and subscription model as the dearest one on the machine.
    """
    costs = defaultdict(float)
    tokens = defaultdict(lambda: defaultdict(int))
    peaks = defaultdict(int)
    models = defaultdict(set)
    sessions = defaultdict(lambda: {"cost": 0.0, "first": "", "last": "",
                                    "peak": None, "final": None, "final_stamp": "", "compacts": 0})
    assumed_total = 0
    unpriced = 0

    for event in events:
        if event.kind == "compact":
            if event.sidechain:
                continue
            row = sessions[event.session]
            row["compacts"] += 1
            raise_peak(row, event.context)
            continue

        if recorded:
            amount, assumed = (event.cost or 0.0), 0
            unpriced += event.cost is None
        else:
            amount, assumed = price(event.usage, event.model, assumed_ttl)
            models[event.bucket].add(tier(event.model))
        costs[event.bucket] += amount
        assumed_total += assumed
        peaks[event.bucket] = max(peaks[event.bucket], event.context)
        for key in TOKEN_CLASSES:
            tokens[event.bucket][key] += event.usage.get(key, 0)

        row = sessions[event.session]
        row["cost"] += amount
        if event.stamp:
            row["first"] = min(row["first"] or event.stamp, event.stamp)
            row["last"] = max(row["last"], event.stamp)
        # A subagent runs in a window of its own, so folding its prompt into the
        # session's figure would describe a context that never existed. Its peak is
        # reported against its own bucket, where its cost already is.
        if not event.sidechain:
            raise_peak(row, event.context)
            if event.stamp >= row["final_stamp"]:
                row["final_stamp"] = event.stamp
                row["final"] = event.context

    return costs, tokens, sessions, models, assumed_total, peaks, unpriced


def resolve_project(root, needle):
    """The one project directory `needle` identifies, or None with a reason printed.

    An exact directory name wins outright, so a substring that happens to be another
    project's whole name can still be reached.
    """
    candidates = sorted(entry for entry in root.iterdir() if entry.is_dir())
    for entry in candidates:
        if entry.name == needle:
            return entry
    matches = [entry for entry in candidates if needle in entry.name]
    if not matches:
        ui.err(f"no project matches {needle!r}")
        ui.note(f"run with no arguments to list what is under {ui.path(root)}")
        return None
    if len(matches) > 1:
        ui.err(f"{needle!r} matches {len(matches)} projects, narrow it")
        for entry in matches:
            ui.item(entry.name)
        return None
    return matches[0]


def list_projects(root):
    if not root.is_dir():
        ui.err(f"no transcripts directory at {ui.path(root)}")
        return EXIT_NOT_FOUND
    names = sorted(entry.name for entry in root.iterdir() if entry.is_dir())
    if not names:
        ui.warn(f"no projects under {ui.path(root)}")
        return EXIT_OK
    ui.title("📊 Projects with transcripts:")
    for name in names:
        ui.item(name)
    ui.done(f"{len(names)} projects")
    return EXIT_OK


def print_sessions(sessions):
    ui.title("📊 Sessions, oldest first:")
    ordered = sorted(sessions.items(), key=lambda kv: kv[1]["first"] or kv[0])
    for session_id, row in ordered:
        span = row["first"][:10] if row["first"] else "undated"
        if row["last"][:10] != row["first"][:10] and row["last"]:
            span = f"{row['first'][:10]} to {row['last'][:10]}"
        print(f"  {session_id}  {row['cost']:>8.2f}  {span}")
    ui.done(f"{len(sessions)} sessions, ${sum(r['cost'] for r in sessions.values()):.2f}")


def human(value):
    """A token count at the scale a reader compares them in, or `-` for nothing measured."""
    if value is None:
        return "-"
    if value >= 1e6:
        return f"{value / 1e6:.1f}M"
    return f"{value / 1e3:.1f}k"


def print_context(sessions, peaks, top, label=BUCKET_LABEL):
    ui.title("📊 Context by session, oldest first:")
    print(f"  {'session':<38}{'peak':>8}{'final':>9}{'compacts':>10}")
    for session_id, row in sorted(sessions.items(), key=lambda kv: kv[1]["first"] or kv[0]):
        print(f"  {session_id:<38}{human(row['peak']):>8}"
              f"{human(row['final']):>9}{row['compacts']:>10}")

    ui.blank()
    ordered = sorted(peaks.items(), key=lambda kv: -kv[1])
    shown = ordered if top <= 0 else ordered[:top]
    ui.title(f"📊 Peak context by {label}:")
    print(f"  {'bucket':<52}{'peak':>9}")
    for name, value in shown:
        print(f"  {name:<52}{human(value):>9}")

    elided = ordered[len(shown):]
    if elided:
        ui.note(f"{len(elided)} more buckets, --top 0 for all")

    ui.blank()
    reached = [row["peak"] for row in sessions.values() if row["peak"] is not None]
    ui.done(f"peak {human(max(reached) if reached else None)} across {len(sessions)} sessions")


def print_buckets(costs, tokens, models, matches, assumed_total, assumed_ttl, top,
                  label=BUCKET_LABEL, unpriced=0):
    total = sum(costs.values())
    ordered = sorted(costs.items(), key=lambda kv: -kv[1])
    shown = ordered if top <= 0 else ordered[:top]

    # The tier column is dropped rather than left blank when nothing populated it, which
    # is every pi run: a bucket that names its own model has no second thing to say.
    tiers = any(models.values())
    ui.title(f"📊 Cost by {label}:")
    print(f"  {'bucket':<52}{'usd':>9}{'Mtok':>8}" + ("  models" if tiers else ""))
    for name, amount in shown:
        volume = sum(tokens[name][key] for key in TOKEN_CLASSES) / 1e6
        suffix = f"  {','.join(sorted(models[name]))}" if tiers else ""
        print(f"  {name:<52}{amount:>9.2f}{volume:>8.1f}{suffix}")

    elided = ordered[len(shown):]
    if elided:
        ui.note(f"{len(elided)} more buckets totalling ${sum(v for _, v in elided):.2f}, --top 0 for all")

    if matches:
        matched = {name: value for name, value in costs.items() if any(m in name for m in matches)}
        subtotal = sum(matched.values())
        ui.blank()
        share = f" ({subtotal / total * 100:.1f}% of the project total)" if total else ""
        ui.ok(f"matched {len(matched)} buckets: ${subtotal:.2f}{share}")
        ui.note(f"patterns: {', '.join(matches)}")

    ui.blank()
    if assumed_total:
        ui.warn(f"{assumed_total:,} cache-write tokens had no TTL breakdown, priced as {assumed_ttl}")
    if unpriced:
        ui.warn(f"{unpriced:,} responses carried no recorded cost and count as $0")
    ui.done(f"${total:.2f} across {len(costs)} buckets")


def as_json(costs, tokens, sessions, models, assumed_total, assumed_ttl, peaks, unpriced=0):
    """Every fact the walk produced, whether or not the run asked to see it printed.

    The context figures are unconditional here, unlike in the tables: this is the one
    output whose content is facts rather than a report of what was asked for.
    """
    payload = {
        "assumed_ttl": assumed_ttl,
        "cache_tokens_priced_by_assumption": assumed_total,
        "responses_without_recorded_cost": unpriced,
        "total_usd": sum(costs.values()),
        "buckets": [
            {
                "bucket": name,
                "usd": costs[name],
                "models": sorted(models[name]),
                "peak_context": peaks[name],
                "tokens": {key: tokens[name][key] for key in TOKEN_CLASSES},
            }
            for name in sorted(costs, key=lambda k: -costs[k])
        ],
        "sessions": [
            {
                "session": key,
                "usd": row["cost"],
                "first": row["first"],
                "last": row["last"],
                "peak_context": row["peak"],
                "final_context": row["final"],
                "compactions": row["compacts"],
            }
            for key, row in sorted(sessions.items(), key=lambda kv: kv[1]["first"] or kv[0])
        ],
    }
    print(json.dumps(payload, indent=2))


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="tokencost",
        description="Price Claude Code or pi work from its session transcripts.",
    )
    parser.add_argument("project", nargs="?",
                        help="any substring identifying one directory under ~/.claude/projects, "
                             "or under ~/.pi/agent/sessions with --pi")
    parser.add_argument("--pi", action="store_true",
                        help="read pi's transcripts instead, bucketed by provider/model and "
                             "priced from the cost pi recorded rather than from the rate table")
    parser.add_argument("--session", help="restrict to one session id, subagents included")
    parser.add_argument("--match", action="append", default=[], metavar="PATTERN",
                        help="subtotal the buckets whose name contains PATTERN (repeatable)")
    parser.add_argument("--since", metavar="YYYY-MM-DD", help="skip records stamped before this date")
    parser.add_argument("--sessions", action="store_true", help="one row per session instead of per bucket")
    parser.add_argument("--context", action="store_true",
                        help="peak and final context per session and per bucket instead of cost "
                             "(--json wins over this, and this wins over --sessions)")
    parser.add_argument("--top", type=int, default=20, metavar="N",
                        help="list only the N costliest buckets, 0 for all (default 20)")
    parser.add_argument("--assume-ttl", choices=sorted(WRITE_MULTIPLIER), default="1h",
                        help="TTL to price cache writes that carry no breakdown (default 1h)")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    args = parser.parse_args(argv)

    root = pi_root() if args.pi else projects_root()
    if not root.is_dir():
        ui.err(f"no transcripts directory at {ui.path(root)}")
        return EXIT_NOT_FOUND
    if not args.project:
        return list_projects(root)

    project_dir = resolve_project(root, args.project)
    if project_dir is None:
        return EXIT_NOT_FOUND

    reader = walk_pi if args.pi else walk
    label = PI_BUCKET_LABEL if args.pi else BUCKET_LABEL
    costs, tokens, sessions, models, assumed, peaks, unpriced = collect(
        reader(project_dir, args.session, args.since), args.assume_ttl, recorded=args.pi)
    if not costs:
        ui.warn("no priced records matched")
        return EXIT_OK

    if args.json:
        as_json(costs, tokens, sessions, models, assumed, args.assume_ttl, peaks, unpriced)
    elif args.context:
        print_context(sessions, peaks, args.top, label)
    elif args.sessions:
        print_sessions(sessions)
    else:
        print_buckets(costs, tokens, models, args.match, assumed, args.assume_ttl, args.top,
                      label, unpriced)
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
