#!/usr/bin/env python3
"""Install, benchmark, select, and diagnose the offline coding models.

The immutable artifact catalog beside this executable is the source of truth. Model
weights live outside the dotfiles checkout, while Ollama manifests and the benchmark
selection are cheap, reproducible state. No normal operation contacts a model vendor;
only the explicit `install` command downloads pinned GGUF artifacts from Hugging Face
or the Ollama registry.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import plistlib
import resource
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_RUNTIME = 3
EXIT_INTERRUPTED = 130
LABEL = "com.jmanuelrosa.local-ai"
OLLAMA_URL = "http://127.0.0.1:11434"
ROOT = Path(__file__).resolve().parent
MANIFEST = ROOT / "models.json"
DATA = Path(
    os.environ.get(
        "LOCAL_AI_DATA_DIR",
        Path.home() / "Library" / "Application Support" / "local-ai",
    )
)
MODEL_DIR = DATA / "models"
RESULTS_DIR = DATA / "benchmarks"
SELECTION = DATA / "selection.json"


def fail(message: str, code: int = EXIT_RUNTIME) -> int:
    print(f"local-ai: {message}", file=sys.stderr)
    return code


def catalog() -> dict:
    try:
        parsed = json.loads(MANIFEST.read_text())
    except (OSError, ValueError) as error:
        raise RuntimeError(f"cannot read {MANIFEST}: {error}") from error
    candidates = parsed.get("candidates")
    if parsed.get("schema") != 1 or not isinstance(candidates, dict) or not candidates:
        raise RuntimeError(f"invalid artifact catalog: {MANIFEST}")
    required = {
        "label",
        "repository",
        "revision",
        "file",
        "bytes",
        "sha256",
        "ollama",
        "reasoning",
    }
    for key, model in candidates.items():
        missing = required - model.keys()
        if missing:
            raise RuntimeError(
                f"{key} is missing catalog fields: {', '.join(sorted(missing))}"
            )
    return parsed


def chosen(keys: list[str], parsed: dict) -> list[str]:
    available = parsed["candidates"]
    keys = keys or [key for key in ("devstral2", "glm47", "qwen36") if key in available]
    unknown = sorted(set(keys) - set(available))
    if unknown:
        raise RuntimeError(f"unknown candidate(s): {', '.join(unknown)}")
    return keys


def command(argv: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(argv, text=True, check=False, **kwargs)


def api(
    path: str, payload: dict | None = None, port: int = 11434, timeout: int = 10
) -> dict:
    data = json.dumps(payload).encode() if payload is not None else None
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}",
        data=data,
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)


def server_ready() -> bool:
    try:
        api("/api/version", timeout=2)
        return True
    except (OSError, ValueError, urllib.error.URLError):
        return False


def wait_for_server(seconds: int = 30) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if server_ready():
            return True
        time.sleep(0.25)
    return False


def launch_domain() -> str:
    return f"gui/{os.getuid()}"


def launch_plist() -> Path:
    return Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"


def start_server() -> int:
    if server_ready():
        print("Ollama is ready on 127.0.0.1:11434")
        return EXIT_OK
    target = f"{launch_domain()}/{LABEL}"
    status = command(["launchctl", "print", target], capture_output=True)
    if status.returncode:
        plist = launch_plist()
        if not plist.is_file():
            return fail(f"launch agent missing at {plist}; run the ai Ansible role")
        launched = command(
            ["launchctl", "bootstrap", launch_domain(), str(plist)], capture_output=True
        )
        if launched.returncode:
            return fail(
                launched.stderr.strip() or "could not load the Ollama launch agent"
            )
    else:
        command(["launchctl", "kickstart", target], capture_output=True)
    if not wait_for_server():
        return fail(
            "Ollama did not become ready; inspect ~/Library/Logs/local-ai/ollama.err.log"
        )
    print("Ollama is ready on 127.0.0.1:11434")
    return EXIT_OK


def stop_server() -> int:
    stopped = command(
        ["launchctl", "bootout", f"{launch_domain()}/{LABEL}"],
        capture_output=True,
    )
    if stopped.returncode and "No such process" not in stopped.stderr:
        return fail(
            stopped.stderr.strip() or "could not unload the Ollama launch agent"
        )
    print("Ollama launch agent stopped")
    return EXIT_OK


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def artifact_url(model: dict) -> str:
    repo = model["repository"]
    revision = model["revision"]
    filename = model["file"]
    return f"https://huggingface.co/{repo}/resolve/{revision}/{filename}?download=true"


def download(key: str, model: dict) -> Path:
    MODEL_DIR.mkdir(parents=True, exist_ok=True)
    destination = MODEL_DIR / model["file"]
    aria_control = destination.with_name(destination.name + ".aria2")
    if aria_control.is_file():
        print(f"[{key}] resuming segmented download for {model['label']}")
    elif destination.is_file():
        size = destination.stat().st_size
        if size == model["bytes"]:
            actual = sha256(destination)
            if actual == model["sha256"]:
                print(f"[{key}] verified existing {destination.name}")
                return destination
            raise RuntimeError(
                f"checksum mismatch for {destination}; move the bad file aside and rerun install"
            )
        if size > model["bytes"]:
            raise RuntimeError(
                f"oversized artifact at {destination}; move it aside and rerun install"
            )
        print(
            f"[{key}] resuming {model['label']} at {size / 1e9:.1f} of {model['bytes'] / 1e9:.1f} GB"
        )
    else:
        print(f"[{key}] downloading {model['label']} ({model['bytes'] / 1e9:.1f} GB)")
    if shutil.which("aria2c"):
        fetched = command(
            [
                "aria2c",
                "--continue=true",
                "--file-allocation=none",
                "--max-connection-per-server=4",
                "--min-split-size=64M",
                "--split=4",
                "--dir",
                str(destination.parent),
                "--out",
                destination.name,
                artifact_url(model),
            ]
        )
    else:
        fetched = command(
            [
                "curl",
                "--fail",
                "--location",
                "--continue-at",
                "-",
                "--output",
                str(destination),
                artifact_url(model),
            ]
        )
    if fetched.returncode:
        raise RuntimeError(f"download failed for {key}; partial file kept for resume")
    actual = sha256(destination)
    if actual != model["sha256"]:
        raise RuntimeError(f"checksum mismatch for downloaded {destination}")
    print(f"[{key}] SHA-256 verified")
    return destination


def ollama_manifest(model: dict) -> Path:
    name, _, tag = model["repository"].partition(":")
    tag = tag or "latest"
    return (
        Path.home()
        / ".ollama"
        / "models"
        / "manifests"
        / "registry.ollama.ai"
        / "library"
        / name
        / tag
    )


def pull_registry(key: str, model: dict) -> Path:
    manifest = ollama_manifest(model)
    if not manifest.is_file() or sha256(manifest) != model["revision"]:
        print(
            f"[{key}] pulling official {model['repository']} ({model['bytes'] / 1e9:.1f} GB)"
        )
        pulled = command(["ollama", "pull", model["repository"]])
        if pulled.returncode:
            raise RuntimeError(f"Ollama registry download failed for {key}")
    if not manifest.is_file() or sha256(manifest) != model["revision"]:
        raise RuntimeError(
            f"registry manifest for {key} does not match the pinned revision"
        )
    blob = Path.home() / ".ollama" / "models" / "blobs" / model["file"]
    if (
        not blob.is_file()
        or blob.stat().st_size != model["bytes"]
        or sha256(blob) != model["sha256"]
    ):
        raise RuntimeError(
            f"registry model blob for {key} failed size or SHA-256 verification"
        )
    print(f"[{key}] official manifest and model blob verified")
    return blob


def model_names() -> set[str]:
    if not server_ready():
        return set()
    response = api("/api/tags")
    return {row.get("name", "") for row in response.get("models", [])}


def metal_ready() -> bool:
    if shutil.which("llama-server") is None:
        return False
    devices = command(["llama-server", "--list-devices"], capture_output=True)
    return devices.returncode == 0 and "Metal" in (devices.stdout + devices.stderr)


def modelfile(model: dict, path: Path | str, context: int) -> str:
    lines = [f"FROM {path}", f"PARAMETER num_ctx {context}"]
    for name, value in model.get("parameters", {}).items():
        lines.append(f"PARAMETER {name} {value}")
    return "\n".join(lines) + "\n"


def import_model(key: str, model: dict, path: Path) -> None:
    installed = model_names()
    base = model["repository"] if model.get("source") == "ollama" else path
    for tag, context in (("32k", 32768), ("64k", 65536)):
        name = f"{model['ollama']}:{tag}"
        if name in installed:
            print(f"[{key}] {name} already exists")
            continue
        DATA.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            "w", suffix=".Modelfile", dir=DATA, delete=False
        ) as handle:
            handle.write(modelfile(model, base, context))
            definition = Path(handle.name)
        try:
            made = command(["ollama", "create", name, "--file", str(definition)])
        finally:
            definition.unlink(missing_ok=True)
        if made.returncode:
            raise RuntimeError(f"Ollama could not import {name}")


def install(keys: list[str]) -> int:
    if shutil.which("ollama") is None:
        return fail("ollama is not installed; run the ai Ansible role")
    if start_server():
        return EXIT_RUNTIME
    parsed = catalog()
    for key in chosen(keys, parsed):
        model = parsed["candidates"][key]
        path = (
            pull_registry(key, model)
            if model.get("source") == "ollama"
            else download(key, model)
        )
        import_model(key, model, path)
    return EXIT_OK


