#!/usr/bin/env python3
"""Entry point for claude-kit.

Kept deliberately thin: the logic lives in the claude_kit/ package beside this
file, so pytest can import and unit-test it. An extensionless executable cannot
be imported, which is why nothing but wiring belongs here.

CPython resolves a symlinked script before deriving sys.path[0], so the package
is normally already reachable through the ~/.local/bin symlink the ai role
creates. The insert below is what keeps that true when the implicit entry is
suppressed, as PYTHONSAFEPATH, -P and -I all do.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from claude_kit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
