#!/usr/bin/env python3
"""Manage Claude Code skills, agents and plugins.

Scope is decided by the `global` group tag, never by the working directory. A
tagged artifact belongs in ~/.claude and nowhere else; everything else belongs
in the enclosing git project and nowhere else. `--global` overrides the second
half for one artifact and records a machine-local pin, so reconciliation keeps
the link instead of pruning it as unrecognised.

Dependencies resolve their own scope rather than inheriting the parent's: a
project skill may depend on a global one and vice versa.

`scout` reads the same catalogue from the other end: it fingerprints the current
project and ranks the skills not already available to it.
"""

import argparse
import json
import os
import re
import sys
import textwrap
from dataclasses import dataclass
from pathlib import Path

EXIT_OK = 0
# Generic failure: bad usage, or an unwritable target. Distinct from the
# refusals below, which each describe a specific, expected situation.
EXIT_USAGE = 1
EXIT_NOT_FOUND = 2
EXIT_DEPENDENCY_ONLY = 3
EXIT_NEEDS_GLOBAL = 4
EXIT_ALREADY_LOCAL = 5
EXIT_ALREADY_GLOBAL = 6
EXIT_NO_PROJECT = 7

CLAUDE_SUBDIR = "roles/ai/files/claude"
PIN_FILE = "claude-kit.json"
# The playbook marks the repo root. Searching for it beats counting parent
# directories, which silently breaks whenever this script moves.
REPO_MARKER = "dotfiles.yml"

SHORTLIST_CAP = 12

# Tags every second skill carries. Matching on them ranks the whole catalogue as
# relevant, which is the same as ranking nothing.
BROAD_TAGS = frozenset({"engineering", "global"})

# Dependency to tag, for the two ecosystems the catalogue actually has skills
# for. Cargo.toml, go.mod and pyproject.toml are deliberately not probed: a hit
# there implies nothing installable.
DEP_TAGS = {
    "react": ("react",),
    "react-dom": ("react",),
    "react-native": ("mobile",),
    "react-router": ("react-router",),
    "react-router-dom": ("react-router",),
    "expo": ("expo",),
    "astro": ("astro",),
    "tailwindcss": ("tailwind",),
    "typescript": ("typescript",),
    "graphql": ("graphql",),
    "fastify": ("fastify",),
    "hono": ("hono",),
    "prisma": ("database",),
    "playwright": ("playwright", "testing"),
    "vitest": ("testing",),
    "jest": ("testing",),
}

# Scoped families, matched by prefix so a new member needs no entry.
DEP_PREFIX_TAGS = {
    "@nestjs/": ("nestjs", "node"),
    "@apollo/": ("graphql",),
    "@prisma/": ("database",),
    "@playwright/": ("playwright", "testing"),
    "@tanstack/": ("react-tanstack",),
    "@sentry/": ("sentry", "observability"),
}

# A direct hit also makes its neighbours plausible, which is what separates the
# two report tiers: direct evidence is a strong match, these are worth a look.
IMPLIED_TAGS = {
    "react": ("frontend", "ui"),
    "react-router": ("frontend",),
    "react-tanstack": ("frontend",),
    "astro": ("frontend",),
    "tailwind": ("frontend", "designer", "design", "ui"),
    "expo": ("mobile",),
    "mobile": ("expo",),
    "nestjs": ("backend",),
    "fastify": ("backend", "node"),
    "hono": ("backend", "node"),
    "graphql": ("backend", "frontend"),
    "database": ("backend",),
    "sentry": ("observability", "devops"),
    "playwright": ("testing",),
    "swift": ("ios", "mobile"),
    "ci": ("devops",),
}

# Read when nothing in the project maps to a tech tag, so the report is never
# empty for a Rust, Go, Python or Ruby codebase.
AGNOSTIC_TAGS = (
    "workflow",
    "review",
    "testing",
    "git",
    "planning",
    "productivity",
    "documentation",
    "refactoring",
)

# Evidence of absence. Real, but it says nothing about the project's stack, so it
# does not count as "this ecosystem is represented in the catalogue".
GAP_TAGS = frozenset({"testing", "ci", "documentation"})

# Descriptions are written for a model's benefit and run long; a few of them are
# a paragraph. The report needs a gist, not the contract.
DESCRIPTION_CAP = 220

# A coarse stand-in for reading a project's prose. It recovers the common cases
# and nothing subtler; the retired skill could infer intent, a script cannot.
INTENT_KEYWORDS = {
    "domain-driven": ("architecture",),
    "domain model": ("architecture",),
    "ddd": ("architecture",),
    "tdd": ("testing",),
    "test-driven": ("testing",),
    "adr": ("documentation",),
}

# Tags that name a specific framework, library or platform. A skill carrying one
# of these is only ever relevant if the project actually uses it, which is what
# keeps an Astro or Apollo skill out of a plain React project's report.
TECH_TAGS = frozenset(
    {
        "apollo",
        "astro",
        "database",
        "expo",
        "fastify",
        "graphql",
        "hono",
        "ios",
        "mobile",
        "nestjs",
        "node",
        "playwright",
        "react",
        "react-router",
        "react-tanstack",
        "sentry",
        "swift",
        "tailwind",
        "typescript",
    }
)

SWIFT_FILES = ("Package.swift", "Podfile")
SWIFT_GLOBS = ("*.xcodeproj", "*.xcworkspace")
TEST_DIRS = ("tests", "test", "__tests__", "spec")
TEST_FILE = re.compile(r"\.(test|spec)\.[jt]sx?$|Tests?\.swift$|^test_.+\.py$")
# Pruned from the test-file walk: a dependency's own tests say nothing about
# whether this project is tested, and node_modules makes the walk unbounded.
NOISE_DIRS = frozenset({"node_modules", "dist", "build", "vendor", "target"})


@dataclass(frozen=True)
class Artifact:
    name: str
    type: str
    groups: tuple
    dependencies: tuple
    dependency_only: bool
    source: Path
    leaf: str
    basename: str


def repo_root():
    """Locate the dotfiles checkout. resolve() follows the ~/.local/bin symlink
    back into the repo, so this works whether invoked from PATH or in place."""
    override = os.environ.get("DOTFILES_DIR")
    if override:
        return Path(override)
    here = Path(__file__).resolve()
    for directory in here.parents:
        if (directory / REPO_MARKER).is_file():
            return directory
    raise SystemExit(
        f"✗ cannot locate the dotfiles repo from {here}. Set DOTFILES_DIR."
    )


def _read_json(path):
    return json.loads(path.read_text())


def _entry_name(entry, repo_key):
    """Basename of upstream_path, falling back to the repo name when the path
    is empty or refers to the repo root."""
    if "name" in entry:
        return entry["name"]
    path = (entry.get("upstream_path") or "").rstrip("/")
    if path in ("", "."):
        return repo_key.split("/")[-1]
    return path.split("/")[-1]


def _registry_entries(registry, collection_key):
    """Yield (name, entry) across both a registry's `repos` and its local list."""
    for repo_key, repo in registry.get("repos", {}).items():
        for entry in repo.get(collection_key, []):
            yield _entry_name(entry, repo_key), entry
    for entry in registry.get(f"local_{collection_key}", []):
        yield entry["name"], entry


def build_catalog(root):
    """Every addable artifact by name. Names are unique across all three types,
    which is what lets `add` infer the type from the name alone."""
    claude = root / CLAUDE_SUBDIR
    catalog = {}

    for kind, registry_file, collection, leaf, suffix in (
        ("skill", "skill-registry.json", "skills", "skills", ""),
        ("agent", "agent-registry.json", "agents", "agents", ".md"),
    ):
        registry = _read_json(claude / registry_file)
        for name, entry in _registry_entries(registry, collection):
            catalog[name] = Artifact(
                name=name,
                type=kind,
                groups=tuple(entry.get("groups", [])),
                dependencies=tuple(entry.get("dependencies") or []),
                dependency_only=bool(entry.get("dependency_only")),
                source=claude / collection / f"{name}{suffix}",
                leaf=leaf,
                basename=f"{name}{suffix}",
            )

    plugins = claude / "plugins"
    if plugins.is_dir():
        for directory in sorted(plugins.iterdir()):
            manifest = directory / ".claude-plugin/plugin.json"
            if not manifest.is_file():
                continue
            data = _read_json(manifest)
            # A plugin bundles only what it owns; skills vendored from upstream
            # stay under skills/ and are named here instead. The key is not
            # `dependencies`, which Claude Code reserves for plugin-to-plugin.
            catalog[directory.name] = Artifact(
                name=directory.name,
                type="plugin",
                groups=tuple(data.get("groups", [])),
                dependencies=tuple(data.get("skillDependencies") or []),
                dependency_only=False,
                source=directory,
                # Plugins share the skills leaf because that is how Claude Code
                # loads one, as <name>@skills-dir.
                leaf="skills",
                basename=directory.name,
            )

    return catalog


def global_set(catalog):
    """Names that belong in ~/.claude: tagged entries plus their declared
    dependencies. A global agent's skill dependencies expand one level further,
    because those skills may themselves depend on others the agent needs."""
    tagged = {name for name, art in catalog.items() if "global" in art.groups}
    effective = set(tagged)
    for name in tagged:
        art = catalog[name]
        for dep in art.dependencies:
            if dep not in catalog:
                continue
            effective.add(dep)
            if art.type == "agent":
                effective.update(d for d in catalog[dep].dependencies if d in catalog)
    return effective


def project_root(cwd):
    start = Path(cwd).resolve()
    for directory in (start, *start.parents):
        if (directory / ".git").exists():
            return directory
    return None


def pin_path(home):
    return home / ".claude" / PIN_FILE


def read_pins(home):
    path = pin_path(home)
    if not path.exists():
        return {}
    return _read_json(path).get("pinned", {})


def add_pin(home, art):
    path = pin_path(home)
    data = _read_json(path) if path.exists() else {}
    bucket = data.setdefault("pinned", {}).setdefault(f"{art.type}s", [])
    if art.name not in bucket:
        bucket.append(art.name)
        bucket.sort()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def link_path(art, scope, home, project):
    root = home if scope == "global" else project
    return root / ".claude" / art.leaf / art.basename


def install(art, scope, home, project):
    destination = link_path(art, scope, home, project)
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.symlink_to(art.source)
    return destination


def fail(code, message):
    print(f"✗ {message}", file=sys.stderr)
    return code


def add_one(catalog, effective, home, cwd, name, want_global):
    art = catalog.get(name)
    if art is None:
        return fail(EXIT_NOT_FOUND, f"'{name}' is not a known skill, agent or plugin.")
    if art.dependency_only:
        return fail(
            EXIT_DEPENDENCY_ONLY,
            f"'{name}' is a dependency-only skill, installed automatically with "
            f"the skill that requires it. Add that skill instead.",
        )
    if name in effective and not want_global:
        return fail(
            EXIT_NEEDS_GLOBAL,
            f"'{name}' is a global {art.type} and belongs in ~/.claude. "
            f"Run: claude-kit add {name} --global",
        )
    if not art.source.exists():
        return fail(
            EXIT_NOT_FOUND,
            f"'{name}' is registered but missing from the repo at {art.source}.",
        )

    project = project_root(cwd)
    if not want_global and project is None:
        return fail(
            EXIT_NO_PROJECT,
            f"'{name}' is project-scoped but there is no git repo here. "
            f"Run it from inside a project, or use --global.",
        )

    # Both refusals are about the named artifact only. A dependency that is
    # already present is normal and never aborts the parent.
    if os.path.lexists(link_path(art, "global", home, project)):
        return fail(EXIT_ALREADY_GLOBAL, f"'{name}' is already installed globally.")
    if not want_global and os.path.lexists(link_path(art, "project", home, project)):
        return fail(EXIT_ALREADY_LOCAL, f"'{name}' is already installed in this project.")

    for dep in art.dependencies:
        dependency = catalog.get(dep)
        if dependency is None:
            print(
                f"⚠ '{name}' declares an unknown dependency '{dep}'.",
                file=sys.stderr,
            )
            continue
        dep_scope = "global" if dep in effective else "project"
        if dep_scope == "project" and project is None:
            print(
                f"⚠ skipped '{dep}', required by '{name}': no project here.",
                file=sys.stderr,
            )
            continue
        if os.path.lexists(link_path(dependency, dep_scope, home, project)):
            continue
        destination = install(dependency, dep_scope, home, project)
        print(f"✓ Linked '{dep}' into {destination.parent} (required by {name})")

    scope = "global" if want_global else "project"
    destination = install(art, scope, home, project)
    print(f"✓ Linked '{name}' into {destination.parent}")

    if want_global and name not in effective:
        add_pin(home, art)
        print(
            f"  Pinned '{name}' as a machine-local global override. "
            f"Tag it `global` in the registry to make that the default everywhere."
        )
    if art.type == "plugin":
        print(
            f"  Restart Claude Code from the project root to load "
            f"'{name}@skills-dir'; the workspace must be trusted."
        )
    return EXIT_OK


def cmd_add(args):
    root = repo_root()
    catalog = build_catalog(root)
    effective = global_set(catalog)
    home = Path.home()
    cwd = Path.cwd()
    for name in args.names:
        code = add_one(catalog, effective, home, cwd, name, args.want_global)
        if code != EXIT_OK:
            return code
    return EXIT_OK


@dataclass(frozen=True)
class Match:
    name: str
    groups: tuple
    description: str
    why: str
    score: int


def read_description(source):
    """A skill's frontmatter description, block scalars included.

    `grep -m1 '^description:'` returns empty for the `description: >-` form, and
    those skills then reach a report with no description at all.
    """
    path = source / "SKILL.md"
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return ""
    if not lines or lines[0].strip() != "---":
        return ""
    for index, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            break
        if not line.startswith("description:"):
            continue
        inline = line[len("description:"):].strip()
        if inline and inline[0] not in "|>":
            return " ".join(inline.strip("'\"").split())
        folded = []
        for continuation in lines[index + 1:]:
            if continuation.strip() == "---":
                break
            if continuation.strip() and not continuation.startswith((" ", "\t")):
                break
            folded.append(continuation.strip())
        return " ".join(" ".join(folded).split())
    return ""


def _has_tests(project):
    if any((project / name).is_dir() for name in TEST_DIRS):
        return True
    for root, dirs, files in os.walk(project):
        dirs[:] = [d for d in dirs if d not in NOISE_DIRS and not d.startswith(".")]
        if any(TEST_FILE.search(name) for name in files):
            return True
    return False


def fingerprint(project):
    """Tags with direct evidence in the project, each mapped to the evidence
    string the report prints as its `Why`. First evidence for a tag wins."""
    direct = {}

    def note(tags, evidence):
        for tag in tags:
            direct.setdefault(tag, evidence)

    manifest = project / "package.json"
    if manifest.is_file():
        try:
            package = _read_json(manifest)
        except (OSError, ValueError):
            package = {}
        declared = {
            **(package.get("dependencies") or {}),
            **(package.get("devDependencies") or {}),
        }
        for name in sorted(declared):
            evidence = f"{name}@{str(declared[name]).lstrip('^~>=< ')} in package.json"
            if name in DEP_TAGS:
                note(DEP_TAGS[name], evidence)
            for prefix, tags in DEP_PREFIX_TAGS.items():
                if name.startswith(prefix):
                    note(tags, evidence)

    markers = [name for name in SWIFT_FILES if (project / name).is_file()]
    markers += sorted(path.name for pattern in SWIFT_GLOBS for path in project.glob(pattern))
    if markers:
        note(("swift", "ios"), f"{markers[0]} in the project root")

    if not _has_tests(project):
        note(("testing",), "no test directory and no test files")
    if not (project / ".github/workflows").is_dir():
        note(("ci",), "no .github/workflows")
    if not (project / "docs").is_dir():
        note(("documentation",), "no docs/ directory")

    for filename in ("CLAUDE.md", "README.md"):
        document = project / filename
        if not document.is_file():
            continue
        try:
            text = document.read_text(errors="replace").lower()
        except OSError:
            continue
        for keyword, tags in INTENT_KEYWORDS.items():
            if keyword in text:
                note(tags, f"{filename} mentions '{keyword}'")

    return direct


def implied_tags(direct):
    """Neighbours of the directly-evidenced tags, minus anything already direct."""
    indirect = {}
    for tag, evidence in direct.items():
        for neighbour in IMPLIED_TAGS.get(tag, ()):
            if neighbour not in direct:
                indirect.setdefault(neighbour, f"implied by {tag} ({evidence})")
    return indirect


def _linked(directory):
    try:
        return {path.name for path in directory.iterdir()}
    except OSError:
        return set()


def rank(candidates, direct, indirect, focus):
    """Split candidates into the two report tiers.

    A tag with direct project evidence is a strong match; a merely implied tag is
    worth considering. Focus, when given, sorts its own matches to the front.
    """
    strong, consider = [], []
    for art, description in candidates:
        tags = set(art.groups) - BROAD_TAGS
        # A skill built for a framework the project does not use is noise, however
        # well its broader tags match. Persona tags like `frontend` are shared by
        # every framework's skills, so without this an implied `frontend` hit
        # pulls in Astro and Apollo alongside React.
        wanted_tech = tags & TECH_TAGS
        if wanted_tech and not wanted_tech & set(direct):
            continue
        hits = sorted(tags & set(direct))
        soft = sorted(tags & set(indirect))
        if hits:
            bucket, matched, source = strong, hits, direct
        elif soft:
            bucket, matched, source = consider, soft, indirect
        else:
            continue
        bucket.append(
            Match(
                name=art.name,
                groups=art.groups,
                description=description,
                why=source[matched[0]],
                score=len(matched),
            )
        )

    def order(match):
        return (0 if focus and focus in match.groups else 1, -match.score, match.name)

    return sorted(strong, key=order), sorted(consider, key=order)


def render_scout(strong, consider, already, focus):
    lines = []
    shown = []
    matches = [*strong, *consider]
    width = max((len(m.name) for m in matches), default=0)

    # Without this, a focus that matches nothing installable reads as a normal
    # report and the unrelated fallback picks look like the answer to it.
    if focus and matches and not any(focus in match.groups for match in matches):
        lines.append(f"Nothing available carries the '{focus}' tag. Showing the rest.")
        lines.append("")

    for title, matches in (("STRONG MATCH", strong), ("WORTH CONSIDERING", consider)):
        if not matches:
            continue
        lines.append(title)
        for match in matches:
            shown.append(match.name)
            lines.append(f"{len(shown):2}. {match.name.ljust(width)}  [{', '.join(match.groups)}]")
            lines.append(f"    Why:  {match.why}")
            if match.description:
                lines.append(
                    textwrap.fill(
                        textwrap.shorten(match.description, DESCRIPTION_CAP, placeholder=" ..."),
                        width=100,
                        initial_indent="    What: ",
                        subsequent_indent="          ",
                    )
                )
        lines.append("")

    if already:
        lines.append("ALREADY IN THIS PROJECT (skipped)")
        lines.extend(f" ✓ {name}" for name in already)
        lines.append("")

    if not shown:
        reason = f"No skill matches the focus '{focus}'." if focus else "Nothing left to add."
        lines.append(reason)
    else:
        lines.append(f"To install: claude-kit add {' '.join(shown)}")

    return "\n".join(lines), shown


def cmd_scout(args):
    root = repo_root()
    catalog = build_catalog(root)
    effective = global_set(catalog)
    home = Path.home()

    project = project_root(Path.cwd())
    if project is None:
        return fail(
            EXIT_NO_PROJECT,
            "scout recommends skills for a project, and there is no git repo here. "
            "Run it from inside a project.",
        )

    # The derived set covers tagged skills and their dependencies; the directory
    # listing and the pin file cover anything made global on this machine only.
    global_names = (
        effective
        | _linked(home / ".claude" / "skills")
        | set(read_pins(home).get("skills", []))
    )
    project_names = _linked(project / ".claude" / "skills")

    candidates = []
    for name, art in sorted(catalog.items()):
        if art.type != "skill" or art.dependency_only:
            continue
        if name in global_names or name in project_names:
            continue
        candidates.append((art, read_description(art.source)))

    direct = fingerprint(project)
    indirect = implied_tags(direct)
    if not set(direct) - GAP_TAGS:
        # Nothing here maps to a tech tag, so the stack is one the catalogue has
        # no skills for. These are guesses, not evidence, so they land in the
        # weaker tier rather than inflating it to a strong match.
        for tag in AGNOSTIC_TAGS:
            if tag not in direct:
                indirect.setdefault(tag, f"no catalogue tech detected, {tag} is stack-agnostic")
    if args.focus:
        direct.setdefault(args.focus, f"requested focus '{args.focus}'")
        indirect.pop(args.focus, None)

    strong, consider = rank(candidates, direct, indirect, args.focus)
    budget = max(SHORTLIST_CAP - len(strong), 0)
    strong, consider = strong[:SHORTLIST_CAP], consider[:budget]

    installed = sorted(
        name
        for name in project_names & set(catalog)
        if catalog[name].type == "skill"
    )
    report, shown = render_scout(strong, consider, installed, args.focus)
    print(report)

    if not args.add or not strong:
        return EXIT_OK

    print()
    for match in strong:
        code = add_one(catalog, effective, home, Path.cwd(), match.name, False)
        if code != EXIT_OK:
            return code
    return EXIT_OK


class Parser(argparse.ArgumentParser):
    """argparse exits 2 on a usage error, which is EXIT_NOT_FOUND here."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, f"✗ {message}\n")


def main(argv=None):
    parser = Parser(
        prog="claude-kit", description="Manage Claude Code skills, agents and plugins."
    )
    subcommands = parser.add_subparsers(dest="command", required=True)

    add = subcommands.add_parser("add", help="Install a skill, agent or plugin")
    add.add_argument("names", nargs="+", metavar="NAME")
    add.add_argument(
        "--global",
        dest="want_global",
        action="store_true",
        help="Install into ~/.claude instead of the current project",
    )
    add.set_defaults(func=cmd_add)

    scout = subcommands.add_parser(
        "scout", help="Recommend skills for the current project, matched to its stack"
    )
    scout.add_argument(
        "--focus", metavar="TAG", help="Promote skills carrying this group tag (e.g. testing)"
    )
    scout.add_argument(
        "--add", action="store_true", help="Install the strong matches instead of only listing them"
    )
    scout.set_defaults(func=cmd_scout)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except OSError as exc:
        return fail(EXIT_USAGE, f"{exc.strerror}: {exc.filename}")


if __name__ == "__main__":
    sys.exit(main())
