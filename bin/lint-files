#!/usr/bin/env python3
"""Print the tracked files one linter owns, one path per line.

The language comes from the shebang before the extension, because the harness hooks
are python behind a .sh name and several scripts carry no extension at all.

Upstream catalog entries are left out: `kura update` replaces them on the next sync,
so a finding there can never be fixed in this repo. Git-ignored tracked files are left out
too, since an edit to one cannot be committed without `git add -f`.
"""

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CATALOG = Path("roles/ai/files/harness/kura/catalog")
CATALOG_KINDS = ("skill", "agent", "bundle")

EXTENSIONS = {".md": "markdown", ".py": "python", ".sh": "shell", ".fish": "fish"}
INTERPRETERS = {"python3": "python", "python": "python", "bash": "shell", "sh": "shell", "fish": "fish"}

# Plan mode writes these, and they are a record of what was approved, not prose to polish.
SKIPPED = {"markdown": (Path("docs/plans"),)}


def upstream_prefixes():
    for kind in CATALOG_KINDS:
        registry = json.loads((ROOT / CATALOG / f"{kind}-registry.json").read_text())
        for source in registry.get("upstream", {}).values():
            for entry in source.get(f"{kind}s", []):
                name = entry.get("name") or Path(entry["upstream_path"]).name
                yield CATALOG / f"{kind}s" / name


def interpreter(path):
    try:
        with (ROOT / path).open("rb") as handle:
            first = handle.readline().decode(errors="ignore")
    except (IsADirectoryError, FileNotFoundError):
        return None
    if not first.startswith("#!"):
        return None
    words = [w for w in first[2:].split() if not w.startswith("-")]
    if not words:
        return None
    command = Path(words[1] if Path(words[0]).name == "env" and len(words) > 1 else words[0]).name
    return INTERPRETERS.get(command)


def language(path):
    return interpreter(path) or EXTENSIONS.get(path.suffix)


def is_under(path, prefixes):
    return any(path == p or p in path.parents or path.with_suffix("") == p for p in prefixes)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in set(EXTENSIONS.values()):
        sys.exit(f"usage: lint-files {{{','.join(sorted(set(EXTENSIONS.values())))}}}")
    wanted = sys.argv[1]
    tracked = subprocess.run(
        ["git", "ls-files", "-z"], cwd=ROOT, capture_output=True, check=True, text=True
    ).stdout.split("\0")
    ignored = set(subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--ignored", "--exclude-standard"],
        cwd=ROOT, capture_output=True, check=True, text=True,
    ).stdout.split("\0"))
    excluded = (*upstream_prefixes(), *SKIPPED.get(wanted, ()))
    for name in filter(None, tracked):
        path = Path(name)
        if name in ignored or is_under(path, excluded):
            continue
        if language(path) == wanted:
            print(path)


if __name__ == "__main__":
    main()
